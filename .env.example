# Aplicacion
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# SQL Server
DB_SERVER=localhost
DB_DATABASE=PRODUCTOS_APP
DB_USER=usuario_sql
DB_PASSWORD=reemplazar
DB_ENCRYPT=false
DB_TRUST_CERT=true

# FTP
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=usuario_ftp
FTP_PASSWORD=reemplazar
FTP_SECURE=false
FTP_TIMEOUT=30000
FTP_VERBOSE=false
FTP_REMOTE_PATH=/PRODUCTOS/MAESTROS
FTP_REMOTE_FILENAME=TBL_MAESTRO_PRODS.TXT
FTP_RETRY_ATTEMPTS=3
FTP_RETRY_DELAY_MS=2000
FTP_CIRCUIT_FAILURE_THRESHOLD=3
FTP_CIRCUIT_OPEN_MS=60000
FTP_CIRCUIT_HALF_OPEN_MAX_MS=30000
FTP_CIRCUIT_STATE_PATH=./tmp/ftp-circuit-state.json

# Archivos y procesos programados
MAESTROS_PATH=./storage/maestros
MAESTROS_TEMP_PATH=./tmp/maestros
MAESTROS_CRON=2-59/10 * * * *
MAESTROS_MAX_MS=1800000
MAESTROS_ESTABILIDAD_MS=5000
PRODUCTOS_ERP_FILE=./storage/maestros/TBL_MAESTRO_PRODS.TXT
PRODUCTOS_ERP_CRON=30 */6 * * *
PRODUCTOS_ERP_MAX_MS=1800000
EXPORT_PATH=./salidas
IMAGENES_PRODUCTOS_PATH=./storage/imagenes-productos
SYNC_RESTART_MS=300000
PROVEEDORES_GOOGLE_SHEET_URL=

# Correo
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASSWORD=reemplazar
SMTP_FROM=Productos App <no-reply@example.com>
SMTP_TIMEOUT_MS=15000
SMTP_EHLO=
SMTP_ALLOW_INVALID_CERT=false
EMAIL_ALLOWED_DOMAIN=example.com
EMAIL_VERIFY_MINUTES=60
PASSWORD_RESET_MINUTES=30

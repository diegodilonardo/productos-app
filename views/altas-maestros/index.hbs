<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><div class="text-secondary fw-bold small">PRESEA</div><h1
      class="h3 mb-1"
    >Maestros</h1><p class="text-secondary mb-0">Consultá los maestros vigentes
      y prepará nuevas altas para el ERP.</p></div>
  <div id="accionesAltasMaestros" class="d-flex gap-2"><button
      id="btnActualizarMaestros"
      class="btn btn-outline-secondary"
    >Actualizar</button><button
      id="btnEnviarMaestros"
      class="btn btn-primary"
    >Enviar DBI a Presea</button></div>
</div>

<div
  class="modal fade"
  id="modalEnvioMaestros"
  tabindex="-1"
  aria-labelledby="tituloModalEnvioMaestros"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5 mb-0" id="tituloModalEnvioMaestros">Archivo
          enviado a Presea</h2>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Cerrar"
        ></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-success mb-3">El envío finalizó correctamente.</div>
        <p id="mensajeModalEnvioMaestros" class="mb-2"></p>
        <div id="archivosModalEnvioMaestros" class="small text-secondary"></div>
      </div>
      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-primary"
          data-bs-dismiss="modal"
        >Entendido</button>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="modalConfirmarSolicitudMaestro"
  tabindex="-1"
  aria-labelledby="tituloConfirmarSolicitudMaestro"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <div class="text-secondary fw-bold small">REVISIÓN PREVIA</div>
          <h2
            class="modal-title h5 mb-0"
            id="tituloConfirmarSolicitudMaestro"
          >Confirmar solicitud</h2>
        </div>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Cerrar"
        ></button>
      </div>
      <div class="modal-body">
        <p class="text-secondary">Revisá la información. La solicitud quedará
          pendiente de envío a Presea.</p>
        <dl id="detalleConfirmarSolicitudMaestro" class="row mb-0"></dl>
      </div>
      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-light border"
          data-bs-dismiss="modal"
        >Volver y corregir</button>
        <button
          type="button"
          class="btn btn-success"
          id="btnConfirmarSolicitudMaestro"
        >Confirmar solicitud</button>
      </div>
    </div>
  </div>
</div>
<div class="nav nav-pills gap-2 mb-4" role="tablist"><button
    id="tabAltasMaestros"
    class="nav-link active"
    type="button"
  >Altas de maestros</button><button
    id="tabConsultaMaestros"
    class="nav-link"
    type="button"
  >Consulta de maestros</button><button
    id="tabReglasEan"
    class="nav-link"
    type="button"
  >Control de EAN</button></div>
<div id="alertaAltasMaestros" class="alert d-none"></div>
<div id="panelReglasEan" class="d-none">
  <div class="card shadow-sm mb-4"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h5 mb-1">Reglas de EAN</h2><p class="text-secondary mb-0">Definí si una combinación de marca, rubro y licencia requiere gestión de EAN.</p></div><span class="badge text-bg-light border">Por defecto: requiere EAN</span></div>
    <div id="formReglaEan" class="row g-2 align-items-end">
      <div class="col-md-3"><label class="form-label" for="marcaReglaEan">Marca</label><select id="marcaReglaEan" class="form-select"><option value="">Seleccione...</option></select></div>
      <div class="col-md-3"><label class="form-label" for="rubroReglaEan">Rubro</label><select id="rubroReglaEan" class="form-select"><option value="">Seleccione...</option></select></div>
      <div class="col-md-3"><label class="form-label" for="licenciaReglaEan">Licencia</label><select id="licenciaReglaEan" class="form-select" disabled><option value="">Sin licencia</option></select></div>
      <div class="col-md-2"><label class="form-label" for="requiereReglaEan">Gestión EAN</label><select id="requiereReglaEan" class="form-select"><option value="true">Requiere EAN</option><option value="false">No requiere EAN</option></select></div>
      <div class="col-md-1"><button id="btnGuardarReglaEan" class="btn btn-primary w-100" type="button">Guardar</button></div>
    </div>
    <div class="table-responsive mt-3"><table class="table table-sm align-middle mb-0"><thead><tr><th>Marca</th><th>Rubro</th><th>Licencia</th><th>Estado</th><th>Actualización</th><th></th></tr></thead><tbody id="tablaReglasEan"><tr><td colspan="6" class="text-center text-secondary">Cargando...</td></tr></tbody></table></div>
  </div></div>
</div>
<div id="panelGestionMaestros">
  <div class="card shadow-sm mb-4"><div class="card-body">
      <div
        class="d-flex flex-wrap justify-content-between align-items-start gap-3"
      ><div><h2 class="h5 mb-1">Carga masiva de modelos</h2><p
            class="text-secondary mb-0"
          >Seleccioná los datos comunes y subí un Excel con los nombres y
            proveedores.</p></div><button
          id="btnDescargarTemplateModelos"
          class="btn btn-outline-primary"
          type="button"
        >Descargar template</button></div>
      <div class="row g-2 mt-2"><div class="col-md-3"><select
            id="marcaModelosMasivos"
            class="form-select"
          ><option value="">Seleccione marca...</option></select></div><div
          class="col-md-3"
        ><select id="rubroModelosMasivos" class="form-select"><option
              value=""
            >Seleccione rubro...</option></select></div><div
          class="col-md-3"
        ><select
            id="licenciaModelosMasivos"
            class="form-select"
            disabled
          ><option value="">Seleccione licencia...</option></select></div><div
          class="col-md-3"
        ><select id="disciplinaModelosMasivos" class="form-select"><option
              value="__SIN_DISCIPLINA__"
            >Sin disciplina</option></select></div></div>
      <div id="datosDisciplinaMasiva" class="mt-2 d-none"><input
          id="prefijoDisciplinaMasiva"
          class="form-control text-uppercase"
          maxlength="2"
          placeholder="2 caracteres para la numeración de esta disciplina"
        /></div>
      <div id="datosLicenciaNuevaMasiva" class="row g-2 mt-1 d-none"><div
          class="col-md-3"
        ><input
            id="prefijoLicenciaMasiva"
            class="form-control text-uppercase"
            maxlength="2"
            placeholder="2 caracteres disponibles"
          /></div><div class="col-md-9"><input
            id="detalleLicenciaMasiva"
            class="form-control text-uppercase"
            maxlength="20"
            placeholder="Nombre de la nueva licencia"
          /></div></div>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-3"><input
          id="archivoModelosMasivos"
          class="form-control"
          style="max-width:520px"
          type="file"
          accept=".xlsx"
        /><button
          id="btnPrevisualizarModelos"
          class="btn btn-primary"
          type="button"
        >Procesar template</button></div>
      <div id="panelVistaPreviaModelos" class="d-none mt-4"><div
          class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"
        ><strong id="resumenVistaPreviaModelos"></strong><div
            class="d-flex gap-2"
          ><button
              id="btnDescargarVistaPreviaModelos"
              class="btn btn-outline-primary"
              type="button"
            >Descargar asignación</button><button
              id="btnConfirmarModelosMasivos"
              class="btn btn-success"
              type="button"
            >Guardar solicitudes</button></div></div><div
          class="table-responsive"
        ><table class="table table-sm align-middle"><thead><tr><th>Fila</th><th
                >Código asignado</th><th>Modelo</th><th>Marca</th><th
                >Rubro</th><th>Licencia</th><th>Disciplina</th><th
                >Proveedor</th><th>Estado</th></tr></thead><tbody
              id="tablaVistaPreviaModelos"
            ></tbody></table></div></div>
    </div></div>
  <div class="row g-4">
    <div class="col-xl-4"><div class="card shadow-sm"><div class="card-body"><h2
            class="h5"
          >Nueva solicitud</h2><form id="formAltaMaestro" class="vstack gap-3">
            <select id="tipoMaestro" class="form-select" required><option
                value="COLOR"
              >Color</option><option value="MODELO">Modelo</option><option
                value="MODULO"
              >Módulo</option></select>
            <div id="referenciasColor" class="vstack gap-2">
              <div class="small text-secondary">Referencia opcional. El color se comparte por empresa.</div>
              <label for="marcaReferenciaColor" class="form-label mb-0">Marca de referencia</label>
              <select id="marcaReferenciaColor" class="form-select"></select>
              <label for="rubroReferenciaColor" class="form-label mb-0">Rubro de referencia</label>
              <select id="rubroReferenciaColor" class="form-select"></select>
            </div>
            <div id="camposModeloPrevios" class="vstack gap-3 d-none"><select
                id="marcaModelo"
                class="form-select"
              ><option value="">Seleccione marca...</option></select><select
                id="rubroModelo"
                class="form-select"
              ><option value="">Seleccione rubro...</option></select><select
                id="licenciaModelo"
                class="form-select"
                disabled
              ><option value="">Seleccione licencia...</option></select><div
                id="datosLicenciaNueva"
                class="vstack gap-2 d-none"
              ><input
                  id="prefijoLicencia"
                  class="form-control text-uppercase"
                  maxlength="2"
                  placeholder="2 primeros caracteres disponibles"
                /><input
                  id="detalleLicenciaNueva"
                  class="form-control text-uppercase"
                  maxlength="20"
                  placeholder="Descripción de la nueva licencia"
                /></div><select
                id="disciplinaModelo"
                class="form-select"
              ><option value="__SIN_DISCIPLINA__">Sin disciplina</option></select><div
                id="datosDisciplina"
                class="d-none"
              ><input
                  id="prefijoDisciplina"
                  class="form-control text-uppercase"
                  maxlength="2"
                  placeholder="2 caracteres para la numeración de esta disciplina"
                /></div></div>
            <div id="camposModuloPrevios" class="vstack gap-2 d-none">
              <label for="marcaModulo" class="form-label mb-0">Marca del módulo</label>
              <select id="marcaModulo" class="form-select"></select>
              <label for="rubroModulo" class="form-label mb-0">Rubro del módulo</label>
              <select id="rubroModulo" class="form-select"><option value="">Seleccione rubro del módulo...</option><option value="CALZADO">Calzado</option><option value="INDUMENTARIA">Indumentaria</option></select>
            </div>
            <div class="input-group"><input
                id="codigoMaestro"
                class="form-control text-uppercase"
                maxlength="6"
                placeholder="Código"
              /><button
                id="btnSugerirCodigo"
                class="btn btn-outline-primary"
                type="button"
              >Sugerir</button></div><input
              id="nombreMaestro"
              class="form-control text-uppercase"
              maxlength="100"
              placeholder="Nombre / descripción"
              required
            /><div
              id="camposModeloPosteriores"
              class="vstack gap-3 d-none"
            ><select id="proveedorModelo" class="form-select"><option
                  value=""
                >Seleccione proveedor...</option></select></div><div
              id="editorModulo"
              class="d-none"
            ><div id="tallesModuloEditor" class="row g-2"></div><div class="alert alert-info mt-3 mb-0 d-flex justify-content-between"><span>Total del módulo</span><strong><span id="paresModuloTotal">0</span> pares/unidades</strong></div></div><button class="btn btn-primary" type="submit">Guardar
              solicitud</button>
          </form></div></div></div>
    <div class="col-xl-8"><div class="card shadow-sm"><div class="card-body"><h2
            class="h5"
          >Solicitudes</h2><div class="table-responsive"><table
              class="table align-middle"
            ><thead><tr><th>Tipo</th><th>Código</th><th>Descripción</th><th
                  >Marca</th><th>Rubro</th><th>Usuario</th><th>Estado</th><th>Fecha</th><th
                    class="text-end"
                  >Acciones</th></tr></thead><tbody
                id="tablaAltasMaestros"
              ></tbody></table></div></div></div></div>
  </div>
</div>
<div id="panelConsultaMaestros" class="d-none">
  <div class="card shadow-sm">
    <div
      class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2"
    ><div><h2 class="h5 mb-1">Consulta de maestros</h2><div
          id="resumenConsultaMaestros"
          class="small text-secondary"
        >Seleccione un maestro para consultar.</div></div><button
        id="btnExportarConsultaMaestros"
        class="btn btn-outline-primary"
        type="button"
      >Exportar consulta</button></div>
    <div class="card-body border-bottom"><div class="row g-2"><div
          class="col-md-3"
        ><select id="tipoConsultaMaestros" class="form-select"><option
              value="MODELOS"
            >Modelos</option><option value="PRODUCTOS">Productos</option><option
              value="PROVEEDORES"
            >Proveedores</option><option value="COLORES">Colores</option><option
              value="MODULOS"
            >Módulos / talles</option><option
              value="DISCIPLINAS"
            >Disciplinas</option></select></div><div class="col-md-5"><input
            id="buscarConsultaMaestros"
            class="form-control"
            type="search"
            placeholder="Buscar por código, descripción..."
          /></div><div class="col-md-4"><select
            id="estadoConsultaModulos"
            class="form-select d-none"
          ><option value="TODOS">Todos los estados</option><option
              value="CONSISTENTES"
            >Consistentes</option><option
              value="INCONSISTENTES"
            >Inconsistentes</option></select><select
            id="filtroTipoProductos"
            class="form-select d-none"
          ><option value="TODOS">Todos los productos</option><option
              value="MODULO"
            >Módulos</option><option value="PAR_SUELTO">Pares sueltos</option></select><select
            id="filtroEstadoProductos"
            class="form-select d-none mt-2"
          ><option value="TODOS">Habilitados e inhabilitados</option><option
              value="HABILITADO"
            >Habilitados</option><option value="INHABILITADO">Inhabilitados en Presea</option></select></div></div><div
        id="filtrosModelosConsulta"
        class="row g-2 mt-1"
      ><div class="col-md-4"><select
            id="filtroMarcaModelos"
            class="form-select"
          ><option value="">Todas las marcas</option></select></div><div
          class="col-md-4"
        ><select id="filtroRubroModelos" class="form-select"><option
              value=""
            >Todos los rubros</option></select></div><div
          class="col-md-4"
        ><select id="filtroLicenciaModelos" class="form-select"><option
              value=""
            >Todas las licencias</option></select></div></div></div>
    <div class="table-responsive"><table
        class="table table-hover align-middle mb-0"
      ><thead id="encabezadoConsultaMaestros" class="table-light"></thead><tbody
          id="tablaConsultaMaestros"
        ></tbody></table></div>
    <div
      class="card-footer bg-white d-flex justify-content-between align-items-center"
    ><span id="rangoConsultaMaestros" class="small text-secondary"></span><div
        class="btn-group"
      ><button
          id="btnAnteriorConsultaMaestros"
          class="btn btn-outline-secondary"
          type="button"
        >Anterior</button><button
          id="paginaConsultaMaestros"
          class="btn btn-light disabled"
          type="button"
        ></button><button
          id="btnSiguienteConsultaMaestros"
          class="btn btn-outline-secondary"
          type="button"
        >Siguiente</button></div></div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><div class="text-secondary fw-bold small">PRESEA</div><h1 class="h3 mb-1">Maestros</h1><p class="text-secondary mb-0">Consultá los maestros vigentes y prepará nuevas altas para el ERP.</p></div>
  <div id="accionesAltasMaestros" class="d-flex gap-2"><button id="btnActualizarMaestros" class="btn btn-outline-secondary">Actualizar</button><button id="btnEnviarMaestros" class="btn btn-primary">Enviar DBI a Presea</button></div>
</div>
<div class="nav nav-pills gap-2 mb-4" role="tablist"><button id="tabAltasMaestros" class="nav-link active" type="button">Altas de maestros</button><button id="tabConsultaMaestros" class="nav-link" type="button">Consulta de maestros</button></div>
<div id="alertaAltasMaestros" class="alert d-none"></div>
<div id="panelGestionMaestros">
  <div class="card shadow-sm mb-4"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h2 class="h5 mb-1">Carga masiva de modelos</h2><p class="text-secondary mb-0">Seleccioná los datos comunes y subí un Excel con los nombres y proveedores.</p></div><button id="btnDescargarTemplateModelos" class="btn btn-outline-primary" type="button">Descargar template</button></div>
    <div class="row g-2 mt-2"><div class="col-md-3"><select id="marcaModelosMasivos" class="form-select"><option value="">Seleccione marca...</option></select></div><div class="col-md-3"><select id="rubroModelosMasivos" class="form-select"><option value="">Seleccione rubro...</option></select></div><div class="col-md-3"><select id="licenciaModelosMasivos" class="form-select" disabled><option value="">Seleccione licencia...</option></select></div><div class="col-md-3"><select id="disciplinaModelosMasivos" class="form-select"><option value="__SIN_DISCIPLINA__">Sin disciplina</option></select></div></div>
    <div id="datosDisciplinaMasiva" class="mt-2 d-none"><input id="prefijoDisciplinaMasiva" class="form-control text-uppercase" maxlength="2" placeholder="2 caracteres para la numeración de esta disciplina"></div>
    <div id="datosLicenciaNuevaMasiva" class="row g-2 mt-1 d-none"><div class="col-md-3"><input id="prefijoLicenciaMasiva" class="form-control text-uppercase" maxlength="2" placeholder="2 caracteres disponibles"></div><div class="col-md-9"><input id="detalleLicenciaMasiva" class="form-control text-uppercase" maxlength="20" placeholder="Nombre de la nueva licencia"></div></div>
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3"><input id="archivoModelosMasivos" class="form-control" style="max-width:520px" type="file" accept=".xlsx"><button id="btnPrevisualizarModelos" class="btn btn-primary" type="button">Procesar template</button></div>
    <div id="panelVistaPreviaModelos" class="d-none mt-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><strong id="resumenVistaPreviaModelos"></strong><div class="d-flex gap-2"><button id="btnDescargarVistaPreviaModelos" class="btn btn-outline-primary" type="button">Descargar asignación</button><button id="btnConfirmarModelosMasivos" class="btn btn-success" type="button">Guardar solicitudes</button></div></div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Fila</th><th>Código asignado</th><th>Modelo</th><th>Marca</th><th>Rubro</th><th>Licencia</th><th>Disciplina</th><th>Proveedor</th><th>Estado</th></tr></thead><tbody id="tablaVistaPreviaModelos"></tbody></table></div></div>
  </div></div>
  <div class="row g-4">
    <div class="col-xl-4"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Nueva solicitud</h2><form id="formAltaMaestro" class="vstack gap-3">
      <select id="tipoMaestro" class="form-select" required><option value="COLOR">Color</option><option value="MODELO">Modelo</option><option value="MODULO">Módulo</option></select>
      <div id="camposModeloPrevios" class="vstack gap-3 d-none"><select id="marcaModelo" class="form-select"><option value="">Seleccione marca...</option></select><select id="rubroModelo" class="form-select"><option value="">Seleccione rubro...</option></select><select id="licenciaModelo" class="form-select" disabled><option value="">Seleccione licencia...</option></select><div id="datosLicenciaNueva" class="vstack gap-2 d-none"><input id="prefijoLicencia" class="form-control text-uppercase" maxlength="2" placeholder="2 primeros caracteres disponibles"><input id="detalleLicenciaNueva" class="form-control text-uppercase" maxlength="20" placeholder="Descripción de la nueva licencia"></div><select id="disciplinaModelo" class="form-select"><option value="__SIN_DISCIPLINA__">Sin disciplina</option></select><div id="datosDisciplina" class="d-none"><input id="prefijoDisciplina" class="form-control text-uppercase" maxlength="2" placeholder="2 caracteres para la numeración de esta disciplina"></div></div>
      <div class="input-group"><input id="codigoMaestro" class="form-control text-uppercase" maxlength="6" placeholder="Código"><button id="btnSugerirCodigo" class="btn btn-outline-primary" type="button">Sugerir</button></div><input id="nombreMaestro" class="form-control text-uppercase" maxlength="100" placeholder="Nombre / descripción" required><div id="camposModeloPosteriores" class="vstack gap-3 d-none"><select id="proveedorModelo" class="form-select"><option value="">Seleccione proveedor...</option></select></div><div id="avisoModulo" class="alert alert-info d-none mb-0">La carga de cantidades por talle se habilitará en el siguiente bloque.</div><button class="btn btn-primary" type="submit">Guardar solicitud</button>
    </form></div></div></div>
    <div class="col-xl-8"><div class="card shadow-sm"><div class="card-body"><h2 class="h5">Solicitudes</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tipo</th><th>Código</th><th>Descripción</th><th>Usuario</th><th>Estado</th><th>Fecha</th></tr></thead><tbody id="tablaAltasMaestros"></tbody></table></div></div></div></div>
  </div>
</div>
<div id="panelConsultaMaestros" class="d-none">
  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Consulta de maestros</h2><div id="resumenConsultaMaestros" class="small text-secondary">Seleccione un maestro para consultar.</div></div><button id="btnExportarConsultaMaestros" class="btn btn-outline-primary" type="button">Exportar consulta</button></div>
    <div class="card-body border-bottom"><div class="row g-2"><div class="col-md-3"><select id="tipoConsultaMaestros" class="form-select"><option value="MODELOS">Modelos</option><option value="PRODUCTOS">Productos</option><option value="COLORES">Colores</option><option value="MODULOS">Módulos / talles</option><option value="DISCIPLINAS">Disciplinas</option></select></div><div class="col-md-5"><input id="buscarConsultaMaestros" class="form-control" type="search" placeholder="Buscar por código, EAN o descripción..."></div><div class="col-md-4"><select id="estadoConsultaModulos" class="form-select d-none"><option value="TODOS">Todos los estados</option><option value="CONSISTENTES">Consistentes</option><option value="INCONSISTENTES">Inconsistentes</option></select><select id="filtroTipoProductos" class="form-select d-none"><option value="TODOS">Todos los productos</option><option value="MODULO">Módulos</option><option value="PAR_SUELTO">Pares sueltos</option></select></div></div><div id="filtrosModelosConsulta" class="row g-2 mt-1"><div class="col-md-4"><select id="filtroMarcaModelos" class="form-select"><option value="">Todas las marcas</option></select></div><div class="col-md-4"><select id="filtroRubroModelos" class="form-select"><option value="">Todos los rubros</option></select></div><div class="col-md-4"><select id="filtroLicenciaModelos" class="form-select"><option value="">Todas las licencias</option></select></div></div></div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead id="encabezadoConsultaMaestros" class="table-light"></thead><tbody id="tablaConsultaMaestros"></tbody></table></div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center"><span id="rangoConsultaMaestros" class="small text-secondary"></span><div class="btn-group"><button id="btnAnteriorConsultaMaestros" class="btn btn-outline-secondary" type="button">Anterior</button><button id="paginaConsultaMaestros" class="btn btn-light disabled" type="button"></button><button id="btnSiguienteConsultaMaestros" class="btn btn-outline-secondary" type="button">Siguiente</button></div></div>
  </div>
</div>

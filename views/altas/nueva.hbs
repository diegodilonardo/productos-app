<div class="nueva-alta-v2">

  <section class="nueva-alta-hero">
    <div class="nueva-alta-hero-main">
      <div class="nueva-alta-hero-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="8.5"></circle>
  <path d="M12 8v8M8 12h8"></path>
</svg>
      </div>

      <div>
        <div class="nueva-alta-kicker">CREACIÓN DE LOTE</div>
        <h1 class="h3 mb-1">Nueva Alta</h1>
        <p class="text-secondary mb-0">
          Definí los datos generales que compartirán todos los productos del lote.
        </p>
      </div>
    </div>

    <a class="btn btn-light border" href="/altas">
      Volver a Altas
    </a>
  </section>

  <div class="nueva-alta-flowbar" aria-label="Flujo del alta">
    <div class="nueva-alta-flowstep is-active">
      <span class="nueva-alta-flow-number">1</span>
      <span class="nueva-alta-flow-copy"><strong>Datos del lote</strong><small>Cabecera</small></span>
    </div>
    <span class="nueva-alta-flow-line"></span>
    <div class="nueva-alta-flowstep">
      <span class="nueva-alta-flow-number">2</span>
      <span class="nueva-alta-flow-copy"><strong>Productos</strong><small>Familias y talles</small></span>
    </div>
    <span class="nueva-alta-flow-line"></span>
    <div class="nueva-alta-flowstep">
      <span class="nueva-alta-flow-number">3</span>
      <span class="nueva-alta-flow-copy"><strong>Validar</strong><small>Consistencia</small></span>
    </div>
    <span class="nueva-alta-flow-line"></span>
    <div class="nueva-alta-flowstep">
      <span class="nueva-alta-flow-number">4</span>
      <span class="nueva-alta-flow-copy"><strong>Exportar</strong><small>Archivo DBI</small></span>
    </div>
    <span class="nueva-alta-flow-line"></span>
    <div class="nueva-alta-flowstep">
      <span class="nueva-alta-flow-number">5</span>
      <span class="nueva-alta-flow-copy"><strong>ERP</strong><small>Confirmación</small></span>
    </div>
  </div>

  <div id="alertaAlta" class="alert d-none" role="alert"></div>

  <div class="row g-4 align-items-stretch">

    <div class="col-12 col-xl-8">
      <div class="card nueva-alta-form-card h-100">
        <div class="nueva-alta-card-head">
          <div class="nueva-alta-section-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
  <rect x="4" y="4" width="16" height="16" rx="2"></rect>
  <path d="M8 9h8M8 13h5"></path>
</svg>
          </div>
          <div>
            <div class="nueva-alta-section-kicker">PASO 1</div>
            <h2 class="h5 mb-1">Datos generales</h2>
            <p class="mb-0 text-secondary small">
              Esta información queda fija para todos los productos que agregues al Alta.
            </p>
          </div>
        </div>

        <div class="card-body nueva-alta-form-body">
          <form id="formNuevaAlta">

            <div class="nueva-alta-block">
              <div class="nueva-alta-block-title">Producto y clasificación</div>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label for="buscarMarca" class="form-label">Marca</label>

                  <div class="nueva-alta-master-search">
                    <input
                      id="buscarMarca"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar marca..."
                    >

                    <input id="codigoMarca" type="hidden" value="">

                    <div id="listaMarca" class="nueva-alta-master-list"></div>

                    <div id="marcaSeleccionada" class="nueva-alta-master-selected d-none">
                      <div class="nueva-alta-master-selected-main">
                        <span class="nueva-alta-master-selected-label">Marca seleccionada</span>
                        <strong id="marcaSeleccionadaDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarMarca"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                  <div class="nueva-alta-field-help">Marca principal del lote.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarRubro" class="form-label">Rubro a generar</label>

                  <div class="nueva-alta-master-search">
                    <input
                      id="buscarRubro"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar rubro..."
                    >

                    <input id="codigoRubro" type="hidden" value="">

                    <div id="listaRubro" class="nueva-alta-master-list"></div>

                    <div id="rubroSeleccionado" class="nueva-alta-master-selected d-none">
                      <div class="nueva-alta-master-selected-main">
                        <span class="nueva-alta-master-selected-label">Rubro seleccionado</span>
                        <strong id="rubroSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarRubro"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                  <div class="nueva-alta-field-help">Define las reglas de productos y talles.</div>
                </div>

                <div class="col-12">
                  <label class="form-label">Tipo de producto</label>
                  <div class="nueva-alta-type-grid">
                    <label class="nueva-alta-type-card" for="tipoProductoModulo">
                      <input class="nueva-alta-type-radio" type="radio" name="tipoProductoVisual" id="tipoProductoModulo" value="MODULO">
                      <span class="nueva-alta-type-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <path d="M4.5 7.5L12 3.8l7.5 3.7V17L12 20.2 4.5 17z"></path>
  <path d="M4.5 7.5L12 11l7.5-3.5M12 11v9.2"></path>
</svg></span>
                      <span class="nueva-alta-type-copy">
                        <strong>MÓDULO</strong>
                        <small>Genera el módulo y sus pares asociados.</small>
                      </span>
                    </label>

                    <label class="nueva-alta-type-card" for="tipoProductoPar">
                      <input class="nueva-alta-type-radio" type="radio" name="tipoProductoVisual" id="tipoProductoPar" value="PAR_SUELTO">
                      <span class="nueva-alta-type-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="8.5"></circle>
  <path d="M8.5 12.2l2.2 2.2 4.8-5"></path>
</svg></span>
                      <span class="nueva-alta-type-copy">
                        <strong>PAR SUELTO</strong>
                        <small>Genera PRIMERA y su SEGUNDA asociada.</small>
                      </span>
                    </label>
                  </div>

                  <select id="tipoProducto" class="form-select nueva-alta-type-select" required>
                    <option value="">Seleccionar...</option>
                    <option value="MODULO">MÓDULO</option>
                    <option value="PAR_SUELTO">PAR SUELTO</option>
                  </select>
                </div>
              </div>
            </div>

            <div class="nueva-alta-block">
              <div class="nueva-alta-block-title">Campaña</div>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label for="buscarAno" class="form-label">Año</label>

                  <div class="nueva-alta-master-search">
                    <input
                      id="buscarAno"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar año..."
                    >

                    <input id="codigoAno" type="hidden" value="">

                    <div id="listaAno" class="nueva-alta-master-list"></div>

                    <div id="anoSeleccionado" class="nueva-alta-master-selected d-none">
                      <div class="nueva-alta-master-selected-main">
                        <span class="nueva-alta-master-selected-label">Año seleccionado</span>
                        <strong id="anoSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarAno"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarTemporada" class="form-label">Temporada</label>

                  <div class="nueva-alta-master-search">
                    <input
                      id="buscarTemporada"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar temporada..."
                    >

                    <input id="codigoTemporada" type="hidden" value="">

                    <div id="listaTemporada" class="nueva-alta-master-list"></div>

                    <div id="temporadaSeleccionada" class="nueva-alta-master-selected d-none">
                      <div class="nueva-alta-master-selected-main">
                        <span class="nueva-alta-master-selected-label">Temporada seleccionada</span>
                        <strong id="temporadaSeleccionadaDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarTemporada"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="nueva-alta-block nueva-alta-block-last">
              <div class="nueva-alta-block-title">Responsable</div>
              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-7">
                  <label for="usuario" class="form-label">Usuario</label>
                  <input
                    id="usuario"
                    type="text"
                    class="form-control text-uppercase"
                    value="{{responsableAlta}}"
                    maxlength="100"
                    readonly
                    aria-readonly="true"
                  >
                  <div class="nueva-alta-field-help">
                    Se toma automáticamente del usuario autenticado{{#if responsableLogin}} ({{responsableLogin}}){{/if}}.
                  </div>
                </div>
              </div>
            </div>

            <div class="nueva-alta-actions">
              <button type="reset" class="btn btn-light border" id="btnLimpiar">Limpiar</button>
              <button type="submit" class="btn btn-primary nueva-alta-create-btn" id="btnCrearAlta">
                Crear Alta y continuar
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-4">
      <div class="card nueva-alta-summary-card h-100">
        <div class="card-body p-4">
          <div class="nueva-alta-summary-kicker">ANTES DE CREAR</div>
          <h2 class="h5 mb-3">Cómo continúa el proceso</h2>

          <div class="nueva-alta-side-step is-current">
            <span class="nueva-alta-side-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <rect x="4" y="4" width="16" height="16" rx="2"></rect>
  <path d="M8 9h8M8 13h5"></path>
</svg></span>
            <div><strong>1. Datos generales</strong><small>Creás la cabecera del lote en BORRADOR.</small></div>
          </div>

          <div class="nueva-alta-side-step">
            <span class="nueva-alta-side-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <path d="M4.5 7.5L12 3.8l7.5 3.7V17L12 20.2 4.5 17z"></path>
  <path d="M4.5 7.5L12 11l7.5-3.5M12 11v9.2"></path>
</svg></span>
            <div><strong>2. Productos</strong><small>Agregás modelo, color, clasificación y curva o talle.</small></div>
          </div>

          <div class="nueva-alta-side-step">
            <span class="nueva-alta-side-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="8.5"></circle>
  <path d="M8.5 12.2l2.2 2.2 4.8-5"></path>
</svg></span>
            <div><strong>3. Validación</strong><small>Se controlan duplicados y consistencia del lote.</small></div>
          </div>

          <div class="nueva-alta-side-step">
            <span class="nueva-alta-side-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <path d="M12 16V5"></path>
  <path d="M8.5 8.5L12 5l3.5 3.5"></path>
  <path d="M5 15.5v3h14v-3"></path>
</svg></span>
            <div><strong>4. Exportación</strong><small>Se genera el DBI para importar en Presea.</small></div>
          </div>

          <div class="nueva-alta-side-step">
            <span class="nueva-alta-side-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
  <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
  <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
  <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path>
</svg></span>
            <div><strong>5. Confirmación ERP</strong><small>Seguimiento y conciliación final.</small></div>
          </div>

          <div class="nueva-alta-note">
            <strong>Importante</strong>
            <span>La cabecera comienza en estado BORRADOR. Podés completar los productos antes de validar.</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div id="panelAltaCreada" class="card nueva-alta-created-card mt-4 d-none">
    <div class="nueva-alta-created-head">
      <div class="d-flex align-items-center gap-3">
        <span class="nueva-alta-created-check"><svg viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="8.5"></circle>
  <path d="M8.5 12.2l2.2 2.2 4.8-5"></path>
</svg></span>
        <div>
          <div class="nueva-alta-section-kicker">CABECERA CREADA</div>
          <h2 class="h5 mb-1">Alta creada correctamente</h2>
          <div class="small text-secondary">La cabecera quedó guardada en estado BORRADOR.</div>
        </div>
      </div>
      <span id="estadoAltaCreada" class="badge text-bg-secondary">BORRADOR</span>
    </div>

    <div class="card-body">
      <div class="nueva-alta-created-grid">
        <div class="nueva-alta-created-item"><span class="app-info-label">ID Alta</span><strong id="altaId">-</strong></div>
        <div class="nueva-alta-created-item nueva-alta-created-code"><span class="app-info-label">Código Alta</span><strong id="altaCodigo" class="font-monospace">-</strong></div>
        <div class="nueva-alta-created-item"><span class="app-info-label">Marca</span><strong id="altaMarca">-</strong></div>
        <div class="nueva-alta-created-item"><span class="app-info-label">Rubro</span><strong id="altaRubro">-</strong></div>
      </div>

      <div class="nueva-alta-created-actions">
        <a href="/altas" class="btn btn-light border">Ver Altas</a>
        <button id="btnContinuarProductos" type="button" class="btn btn-success" disabled>
          Continuar con productos
        </button>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
  function sincronizarVisualDesdeSelect() {
    const select = document.getElementById('tipoProducto');
    if (!select) return;
    document.querySelectorAll('.nueva-alta-type-radio').forEach(radio => {
      radio.checked = radio.value === select.value;
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    const select = document.getElementById('tipoProducto');
    const radios = document.querySelectorAll('.nueva-alta-type-radio');

    radios.forEach(radio => {
      radio.addEventListener('change', function () {
        if (!select || !radio.checked) return;
        select.value = radio.value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    if (select) {
      select.addEventListener('change', sincronizarVisualDesdeSelect);
    }

    const form = document.getElementById('formNuevaAlta');
    if (form) {
      form.addEventListener('reset', function () {
        setTimeout(sincronizarVisualDesdeSelect, 0);
      });
    }

    sincronizarVisualDesdeSelect();
  });
})();
</script>
<script src="/js/nueva-alta.js"></script>

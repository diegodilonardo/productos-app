<link rel="stylesheet" href="/css/alta-productos-v2.css?v=2">

<div id="paginaProductosAlta" data-id-alta="{{idAlta}}" class="alta-v2">
  <!-- HERO / CABECERA -->
  <section class="alta-hero mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div class="d-flex align-items-start gap-3">
        <div class="alta-hero-icon" aria-hidden="true">A</div>
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h1 class="h3 mb-0">Productos del Alta</h1>
            <span id="estadoAltaCabecera" class="badge rounded-pill text-bg-secondary px-3 py-2">-</span>
          </div>
          <div id="codigoAltaCabecera" class="font-monospace text-secondary">Cargando...</div>
          <p class="text-secondary mb-0 mt-2">
            Generá las familias del lote, revisá sus estados y completá el circuito hacia Presea.
          </p>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/altas" class="btn btn-light border">Volver a Altas</a>
        <a href="/altas/nueva" class="btn btn-outline-primary">Nueva Alta</a>
      </div>
    </div>

    <div class="alta-meta-grid mt-4">
      <div class="alta-meta-item">
        <span class="alta-meta-label">ID</span>
        <strong id="infoIdAlta">-</strong>
      </div>
      <div class="alta-meta-item">
        <span class="alta-meta-label">Marca</span>
        <strong id="infoMarca">-</strong>
      </div>
      <div class="alta-meta-item">
        <span class="alta-meta-label">Rubro</span>
        <strong id="infoRubro">-</strong>
      </div>
      <div class="alta-meta-item">
        <span class="alta-meta-label">Tipo</span>
        <strong id="infoTipo">-</strong>
      </div>
      <div class="alta-meta-item">
        <span class="alta-meta-label">Año</span>
        <strong id="infoAno">-</strong>
      </div>
      <div class="alta-meta-item">
        <span class="alta-meta-label">Temporada</span>
        <strong id="infoTemporada">-</strong>
      </div>
    </div>
  </section>

  <div id="alertaProductos" class="alert d-none shadow-sm" role="alert"></div>

  <div class="row g-4">
    <!-- FORMULARIO -->
    <div id="panelCargaProductos" class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm alta-card">
        <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
              <div class="alta-section-kicker">GENERACIÓN</div>
              <h2 class="h5 mb-1">Agregar producto</h2>
              <div class="small text-secondary">
                Seleccioná los datos del producto principal. La familia automática se genera en el backend.
              </div>
            </div>
          </div>
        </div>

        <div class="card-body px-4 pb-4">
          <form id="formProducto">
            <!-- BLOQUE 1 -->
            <div class="alta-form-section">
              <div class="alta-form-section-title">
                <span class="alta-step">1</span>
                Producto
              </div>

              <div class="row g-3">
                <div class="col-12 col-lg-5">
                  <label for="licenciaModelo" class="form-label fw-semibold">Licencia</label>
                  <select id="licenciaModelo" class="form-select form-select-lg">
                    <option value="">Todas las licencias</option>
                  </select>
                  <div class="form-text">
                    Filtra los modelos según la marca y rubro. El primer producto define
                    la licencia del Alta y luego queda bloqueada para evitar mezclas.
                  </div>
                </div>

                <div class="col-12">
                  <label for="buscarModelo" class="form-label fw-semibold">Modelo</label>

                  <div class="alta-model-search">
                    <input
                      id="buscarModelo"
                      type="search"
                      class="form-control form-control-lg"
                      placeholder="Escribí código o nombre del modelo..."
                      autocomplete="off"
                    >

                    <input
                      id="codigoModelo"
                      type="hidden"
                      required
                    >

                    <div id="modeloSeleccionado" class="alta-model-selected d-none">
                      <div>
                        <span class="alta-model-selected-label">Modelo seleccionado</span>
                        <strong id="modeloSeleccionadoTexto">-</strong>
                      </div>
                      <button
                        id="btnLimpiarModelo"
                        type="button"
                        class="btn btn-sm btn-light border"
                      >
                        Cambiar
                      </button>
                    </div>

                    <div id="listaModelos" class="alta-model-list">
                      <div class="text-secondary p-3">
                        Cargando modelos...
                      </div>
                    </div>
                  </div>

                  <div class="form-text">
                    Buscá por código o nombre. Si elegís una licencia, la búsqueda queda limitada a esa licencia.
                  </div>
                </div>

                <div class="col-12">
                  <label for="buscarProveedor" class="form-label">Proveedor</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarProveedor"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar proveedor..."
                    >

                    <input id="codigoProveedor" type="hidden" value="">

                    <div id="listaProveedor" class="alta-master-list"></div>

                    <div id="proveedorSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Proveedor seleccionado</span>
                        <strong id="proveedorSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarProveedor"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarGrupo" class="form-label">Grupo</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarGrupo"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar grupo..."
                    >

                    <input
                      id="codigoGrupo"
                      type="hidden"
                      value=""
                    >

                    <div id="listaGrupo" class="alta-master-list"></div>

                    <div id="grupoSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Grupo seleccionado</span>
                        <strong id="grupoSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarGrupo"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarSubgrupo" class="form-label">Subgrupo</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarSubgrupo"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar subgrupo..."
                    >

                    <input
                      id="codigoSubgrupo"
                      type="hidden"
                      value=""
                    >

                    <div id="listaSubgrupo" class="alta-master-list"></div>

                    <div id="subgrupoSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Subgrupo seleccionado</span>
                        <strong id="subgrupoSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarSubgrupo"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarLinea" class="form-label">Línea</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarLinea"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar línea..."
                    >

                    <input
                      id="codigoLinea"
                      type="hidden"
                      value=""
                    >

                    <div id="listaLinea" class="alta-master-list"></div>

                    <div id="lineaSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Línea seleccionado</span>
                        <strong id="lineaSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarLinea"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="buscarDeporte" class="form-label">Deporte</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarDeporte"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar deporte..."
                    >

                    <input
                      id="codigoDeporte"
                      type="hidden"
                      value=""
                    >

                    <div id="listaDeporte" class="alta-master-list"></div>

                    <div id="deporteSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Deporte seleccionado</span>
                        <strong id="deporteSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarDeporte"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BLOQUE 2 -->
            <div class="alta-form-section">
              <div class="alta-form-section-title">
                <span class="alta-step">2</span>
                Segmentación y origen
              </div>

              <div class="row g-3">
                <div class="col-12 col-md-4">
                  <label for="buscarEdad" class="form-label">Edad</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarEdad"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar edad..."
                    >

                    <input id="codigoEdad" type="hidden" value="">

                    <div id="listaEdad" class="alta-master-list"></div>

                    <div id="edadSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Edad seleccionada</span>
                        <strong id="edadSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarEdad"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-4">
                  <label for="buscarSexo" class="form-label">Sexo</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarSexo"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar sexo..."
                    >

                    <input id="codigoSexo" type="hidden" value="">

                    <div id="listaSexo" class="alta-master-list"></div>

                    <div id="sexoSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">Sexo seleccionado</span>
                        <strong id="sexoSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarSexo"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>

                <div class="col-12 col-md-4">
                  <label for="buscarPais" class="form-label">País</label>

                  <div class="alta-master-search">
                    <input
                      id="buscarPais"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar país..."
                    >

                    <input id="codigoPais" type="hidden" value="">

                    <div id="listaPais" class="alta-master-list"></div>

                    <div id="paisSeleccionado" class="alta-master-selected d-none">
                      <div class="alta-master-selected-main">
                        <span class="alta-master-selected-label">País seleccionado</span>
                        <strong id="paisSeleccionadoDetalle"></strong>
                      </div>

                      <button
                        id="btnLimpiarPais"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Cambiar
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BLOQUE 3 -->
            <div class="alta-form-section">
              <div class="alta-form-section-title">
                <span class="alta-step">3</span>
                Clasificación, curva y color
              </div>

              <div class="row g-3">
                <div id="contenedorClasificacion" class="col-12 col-md-6">
                  <label for="codigoClasificacion" class="form-label">Clasificación</label>
                  <select id="codigoClasificacion" class="form-select"></select>
                </div>

                <div id="contenedorModulo" class="col-12 d-none">
                  <label for="buscarModulo" class="form-label fw-semibold">Curva / Módulo</label>

                  <div class="alta-module-search">
                    <input
                      id="buscarModulo"
                      type="search"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Buscar por código, talle, rango, composición o pares..."
                    >

                    <input
                      id="codigoModulo"
                      type="hidden"
                      value=""
                    >

                    <div id="listaModulos" class="alta-module-list"></div>

                    <div id="moduloSeleccionado" class="alta-module-selected d-none">
                      <div class="alta-module-selected-main">
                        <span class="alta-module-selected-label">Curvas seleccionadas</span>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                          <span id="moduloSeleccionadoCodigo" class="alta-module-code"></span>
                        </div>
                        <div
                          id="modulosSeleccionadosChips"
                          class="d-flex flex-wrap gap-2"
                          aria-label="Curvas seleccionadas"
                        ></div>
                        <div id="moduloSeleccionadoComposicion" class="alta-module-composition mt-2"></div>
                      </div>

                      <button
                        id="btnLimpiarModulo"
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Limpiar curvas
                      </button>
                    </div>
                  </div>

                  <div class="form-text">
                    Podés elegir varias curvas. Se generarán todas las combinaciones entre los colores y las curvas seleccionadas.
                  </div>
                </div>

                <div id="contenedorTalle" class="col-12 d-none">
                  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <label for="buscarTalle" class="form-label fw-semibold mb-0">Talles</label>
                    <span id="cantidadTalles" class="badge rounded-pill text-bg-secondary px-3 py-2">
                      0 seleccionados
                    </span>
                  </div>

                  <input id="codigoTalle" type="hidden" value="">

                  <div
                    id="tallesSeleccionados"
                    class="d-none flex-wrap gap-2 mb-3"
                    aria-label="Talles seleccionados"
                  ></div>

                  <input
                    id="buscarTalle"
                    type="search"
                    class="form-control mb-2"
                    autocomplete="off"
                    placeholder="Buscar por código o talle..."
                  >

                  <div id="listaTalles" class="app-color-list alta-color-list"></div>
                  <div class="form-text">
                    Podés elegir varios talles. Se generarán todas las combinaciones entre los talles y colores seleccionados.
                  </div>
                </div>

                <div class="col-12">
                  <div class="alta-color-box">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                      <div>
                        <label class="form-label fw-semibold mb-0">Colores</label>
                        <div class="small text-secondary">Podés generar varias familias en una sola operación.</div>
                      </div>
                      <span id="cantidadColores" class="badge rounded-pill text-bg-secondary px-3 py-2">
                        0 seleccionados
                      </span>
                    </div>

                    <div
                      id="coloresSeleccionados"
                      class="d-none flex-wrap gap-2 mb-3"
                      aria-label="Colores seleccionados"
                    ></div>

                    <input
                      id="buscarColor"
                      type="search"
                      class="form-control mb-2"
                      placeholder="Buscar por código o descripción del color..."
                    >

                    <div id="listaColores" class="app-color-list alta-color-list">
                      <div class="text-secondary p-2">Cargando colores...</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- BLOQUE 4 -->
            <div class="alta-form-section mb-0">
              <div class="alta-form-section-title">
                <span class="alta-step">4</span>
                Confirmación
              </div>

              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                  <label for="usuarioProducto" class="form-label">Usuario</label>
                  <input
                    id="usuarioProducto"
                    type="text"
                    class="form-control text-uppercase"
                    value=""
                    readonly
                    required
                  >
                </div>

                <div class="col-12 col-md-6">
                  <button id="btnAgregarProducto" type="submit" class="btn btn-primary btn-lg w-100">
                    + Agregar producto al lote
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- RESUMEN -->
    <div class="col-12 col-xl-4">
      <div class="alta-sticky-panel">
        <div class="card border-0 shadow-sm alta-card">
          <div class="card-body p-4">
            <div class="alta-section-kicker">LOTE</div>
            <h2 class="h5 mb-3">Resumen y acciones</h2>

            <div class="alta-counter-grid mb-3">
              <div class="alta-counter alta-counter-total">
                <span id="cantidadProductosAlta">0</span>
                <small>Registrados</small>
              </div>
              <div class="alta-counter alta-counter-new">
                <span id="cantidadProductosExportables">0</span>
                <small>Exportables</small>
              </div>
              <div class="alta-counter alta-counter-existing">
                <span id="cantidadProductosExistentesERP">0</span>
                <small>En Presea</small>
              </div>
            </div>

            <div class="alta-summary-row">
              <span>Estado del lote</span>
              <strong id="estadoLote">-</strong>
            </div>

            <div class="alta-summary-row align-items-start">
              <span>Archivo DBI</span>
              <strong id="archivoExportadoAlta" class="text-break text-end ms-3">-</strong>
            </div>

            <div id="mensajeEstadoAlta" class="alert alert-secondary mt-3 mb-3">
              Cargando estado...
            </div>

            <div id="panelMotivoAnulacion" class="alta-cancel-reason d-none mb-3">
              <div class="alta-cancel-reason-label">Motivo de anulación</div>
              <div id="motivoAnulacionAlta" class="alta-cancel-reason-text">-</div>
            </div>

            <div class="d-grid gap-2">
              <button
                id="btnVolverAltas"
                type="button"
                class="btn btn-outline-success d-none"
              >
                Volver a Altas
              </button>

              <div
                id="mensajeGuardadoAutomatico"
                class="small text-secondary text-center d-none"
              >
                Los productos agregados y las imágenes se guardan automáticamente.
              </div>

              <button
                id="btnBorradorExcel"
                type="button"
                class="btn btn-outline-primary d-none"
                disabled
              >
                Exportar Excel con imágenes
              </button>

              <button
                id="btnDescargarImagenesAlta"
                type="button"
                class="btn btn-outline-primary d-none"
                disabled
              >
                Descargar imágenes (ZIP)
              </button>

              <button
                id="btnAnularAlta"
                type="button"
                class="btn btn-outline-danger d-none"
              >
                Anular Alta
              </button>

              <button id="btnValidarAlta" type="button" class="btn btn-success d-none" disabled>
                Validar Alta
              </button>

              <button id="btnPreviewAlta" type="button" class="btn btn-outline-primary d-none" disabled>
                Preview DBI
              </button>

              <button id="btnExportarAlta" type="button" class="btn btn-primary d-none" disabled>
                Exportar DBI
              </button>

              <a
                id="btnSeguimientoAlta"
                href="/seguimiento/{{idAlta}}"
                class="btn btn-outline-primary d-none"
              >
                Ver seguimiento ERP
              </a>

              <button id="btnActualizarAlta" type="button" class="btn btn-light border">
                Actualizar lote
              </button>
            </div>

            <div class="alta-rule-note mt-3">
              <strong>Regla de generación</strong>
              <div>
                MÓDULO genera módulo + PRIMERAS + SEGUNDAS por talle activo.
                PAR SUELTO genera PRIMERA + SEGUNDA.
              </div>
            </div>
          </div>
        </div>

        <div id="panelInformacionAdicional" class="card border-0 shadow-sm alta-card mt-3">
          <div class="card-body p-4">
            <div class="alta-section-kicker">PRODUCTO</div>
            <h2 class="h5 mb-1">Información adicional</h2>
            <p class="small text-secondary mb-3">
              Estos datos se aplican a toda la familia que se genere.
            </p>

            <div class="row g-3">
              <div class="col-12 col-md-6 col-xl-12">
                <label for="coNew" class="form-label">CO_NEW</label>
                <input id="coNew" form="formProducto" type="text" class="form-control" maxlength="50">
              </div>

              <div class="col-12 col-md-6 col-xl-12">
                <label for="muestra" class="form-label">Muestra</label>
                <input id="muestra" form="formProducto" type="text" class="form-control" maxlength="50">
              </div>

              <div class="col-12">
                <label for="comentario" class="form-label">Comentario</label>
                <textarea id="comentario" form="formProducto" class="form-control" rows="2" maxlength="255"></textarea>
              </div>

              <div class="col-12">
                <label for="correcciones" class="form-label">Correcciones</label>
                <textarea id="correcciones" form="formProducto" class="form-control" rows="2" maxlength="255"></textarea>
              </div>

              <div class="col-12 col-md-6 col-xl-12">
                <label for="materialCalzado" class="form-label">Material del calzado</label>
                <input id="materialCalzado" form="formProducto" type="text" class="form-control" maxlength="100">
              </div>

              <div class="col-12 col-md-6 col-xl-12">
                <label for="materialSuela" class="form-label">Material de la suela</label>
                <input id="materialSuela" form="formProducto" type="text" class="form-control" maxlength="100">
              </div>

              <div class="col-12 col-md-6 col-xl-12">
                <label for="tipoAjuste" class="form-label">Tipo de ajuste</label>
                <input id="tipoAjuste" form="formProducto" type="text" class="form-control" maxlength="100">
              </div>

              <div class="col-12 col-md-6 col-xl-12">
                <label for="flow" class="form-label">Flow</label>
                <input id="flow" form="formProducto" type="text" class="form-control" maxlength="100">
              </div>

              <div class="col-12">
                <label for="descripcion" class="form-label">Descripción</label>
                <textarea id="descripcion" form="formProducto" class="form-control" rows="3" maxlength="500"></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PRODUCTOS GENERADOS -->
  <div class="card border-0 shadow-sm alta-card mt-4">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-3">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
          <div class="alta-section-kicker">RESULTADO</div>
          <h2 class="h5 mb-1">Productos generados</h2>
          <div class="small text-secondary">
            Los productos principales se destacan; sus hijos automáticos aparecen subordinados visualmente.
          </div>
          <div class="alta-family-inline-note mt-2">
            <span aria-hidden="true">▧</span>
            La imagen se administra desde la fila principal y se comparte con toda la familia.
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2 small">
          <span class="badge rounded-pill text-bg-success px-3 py-2">NUEVO</span>
          <span class="badge rounded-pill text-bg-warning px-3 py-2">YA EXISTE EN PRESEA</span>
        </div>
      </div>
    </div>

    <div class="alta-products-filterbar">
      <div class="alta-products-search">
        <span class="alta-products-search-icon" aria-hidden="true">⌕</span>
        <input
          id="filtroProductosTexto"
          type="search"
          class="form-control"
          placeholder="Buscar por código, detalle o color..."
          autocomplete="off"
        >
      </div>

      <div class="alta-products-filter">
        <label for="filtroProductosEstado">Estado</label>
        <select id="filtroProductosEstado" class="form-select">
          <option value="">Todos</option>
          <option value="NUEVO">Nuevo</option>
          <option value="EXISTE_ERP">Ya existe en Presea</option>
        </select>
      </div>

      <div class="alta-products-filter">
        <label for="filtroProductosTipo">Tipo</label>
        <select id="filtroProductosTipo" class="form-select">
          <option value="">Todos</option>
          <option value="MODULO">Módulo</option>
          <option value="PAR_SUELTO">Par suelto</option>
        </select>
      </div>

      <div class="alta-products-filter">
        <label for="filtroProductosOrigen">Origen</label>
        <select id="filtroProductosOrigen" class="form-select">
          <option value="">Todos</option>
          <option value="PRINCIPAL">Principal</option>
          <option value="AUTOMATICO">Automático</option>
        </select>
      </div>

      <button
        id="btnLimpiarFiltrosProductos"
        type="button"
        class="btn btn-link alta-products-clear-filter"
      >
        <span aria-hidden="true">×</span>
        Limpiar filtros
      </button>

      <div
        id="resultadoFiltrosProductos"
        class="alta-products-filter-result"
        aria-live="polite"
      ></div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 alta-products-table">
        <thead>
          <tr>
            <th>COD_ALFA</th>
            <th>Detalle</th>
            <th>Tipo</th>
            <th>Clasif.</th>
            <th>Color</th>
            <th>Talle / Curva</th>
            <th>Origen</th>
            <th>Imagen</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody id="tablaProductosAlta">
          <tr>
            <td colspan="10" class="text-center py-5 text-secondary">Cargando...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="panelResultadoExportacion" class="card shadow-sm mt-4 d-none">
  <div class="card-header bg-white">
    <h2 class="h5 mb-0">Exportación generada</h2>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-12 col-md-4">

<div class="login-shell">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-brand-mark">PA</div>
      <div>
        <div class="login-kicker">PRODUCTOS APP</div>
        <h1 class="h3 mb-1">Recuperar contraseña</h1>
        <p class="text-secondary mb-0">
          Ingresá tu usuario o correo. Si la cuenta existe, enviaremos un enlace de recuperación.
        </p>
      </div>
    </div>

    <div id="alertaRecuperacion" class="alert d-none mt-4" role="alert"></div>

    <form id="formRecuperacion" class="mt-4" novalidate>
      <div class="mb-4">
        <label class="form-label" for="identificador">Usuario o correo</label>
        <input
          id="identificador"
          class="form-control form-control-lg"
          type="text"
          maxlength="200"
          autocomplete="username"
          required
          autofocus
        >
      </div>

      <button id="btnEnviarRecuperacion" class="btn btn-primary btn-lg w-100" type="submit">
        Enviar enlace
      </button>

      <div class="text-center mt-3">
        <a href="/login" class="small text-decoration-none">Volver al login</a>
      </div>
    </form>
  </div>
</div>

<div class="login-shell" id="resetApp" data-token="{{token}}">
  <div class="login-card">
    <div class="login-brand">
      <div class="login-brand-mark">PA</div>
      <div>
        <div class="login-kicker">PRODUCTOS APP</div>
        <h1 class="h3 mb-1">Nueva contraseña</h1>
        <p class="text-secondary mb-0">
          Definí una nueva contraseña para tu cuenta.
        </p>
      </div>
    </div>

    <div id="alertaReset" class="alert d-none mt-4" role="alert"></div>

    <form id="formReset" class="mt-4" novalidate>
      <div class="mb-3">
        <label class="form-label" for="passwordNueva">Nueva contraseña</label>
        <input
          id="passwordNueva"
          class="form-control form-control-lg"
          type="password"
          minlength="8"
          maxlength="200"
          autocomplete="new-password"
          required
          autofocus
        >
      </div>

      <div class="mb-4">
        <label class="form-label" for="passwordConfirmar">Confirmar contraseña</label>
        <input
          id="passwordConfirmar"
          class="form-control form-control-lg"
          type="password"
          minlength="8"
          maxlength="200"
          autocomplete="new-password"
          required
        >
      </div>

      <button id="btnRestablecer" class="btn btn-primary btn-lg w-100" type="submit">
        Guardar nueva contraseña
      </button>

      <div class="text-center mt-3">
        <a href="/login" class="small text-decoration-none">Volver al login</a>
      </div>
    </form>
  </div>
</div>

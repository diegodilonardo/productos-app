<div class="pedidos-v1 pedido-detail-shell" id="pedidoDetalleApp" data-id-pedido="{{idPedido}}">
  <section class="pedido-detail-hero">
    <div class="pedido-detail-title">
      <span class="pedido-detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12a2 2 0 0 1 2 2v16H4V5a2 2 0 0 1 2-2Z"/><path d="M8 3v4h8V3M8 11h8M8 15h5"/></svg>
      </span>
      <div class="min-w-0">
        <div class="pedidos-kicker">PEDIDO</div>
        <h1 id="tituloPedido" class="pedido-detail-code mb-0">Cargando...</h1>
        <div id="subtituloPedido" class="pedido-detail-subtitle"></div>
      </div>
    </div>
    <div class="pedido-action-area">
      <div id="accionesExportacionPedido" class="d-flex flex-wrap gap-2 d-none">
        <a id="btnExportarPedidoExcel" class="btn btn-outline-primary" href="#">Exportar Pedido Excel</a>
        <a id="btnExportarMasterData" class="btn btn-outline-primary" href="#">Exportar Master Data</a>
        <a id="btnExportarPrecFob" class="btn btn-outline-primary" href="#">Exportar PREC_FOB</a>
      </div>
      <a class="btn btn-outline-secondary" href="/pedidos">Volver</a>
      <button id="btnAnularPedido" class="btn btn-outline-danger d-none" type="button">Anular</button>
      <button id="btnValidarPedido" class="btn btn-success d-none" type="button">Validar Pedido</button>
    </div>
  </section>

  <div id="alertaDetallePedido" class="alert d-none pedido-detail-alert" role="alert"></div>

  <section class="pedido-summary-grid" aria-label="Resumen del pedido">
    <div class="pedido-summary-card"><span class="pedido-summary-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 8 4-8 4-8-4 8-4Z"/><path d="m4 11 8 4 8-4M4 15l8 4 8-4"/></svg></span><div><div class="pedido-summary-label">Productos</div><div id="metDetalleProductos" class="pedido-summary-value">-</div><div class="pedido-summary-caption">ítems del pedido</div></div></div>
    <div class="pedido-summary-card"><span class="pedido-summary-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M3 20v-1a5 5 0 0 1 10 0v1M11 20v-1a5 5 0 0 1 10 0v1"/></svg></span><div><div class="pedido-summary-label">Pares</div><div id="metDetallePares" class="pedido-summary-value">-</div><div class="pedido-summary-caption">cantidad total</div></div></div>
    <div class="pedido-summary-card"><span class="pedido-summary-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M16 8.5c-.8-.9-2-1.5-3.5-1.5-2 0-3.5 1-3.5 2.5s1.2 2.1 3.5 2.5c2.3.4 3.5 1 3.5 2.5S14.5 17 12.5 17C11 17 9.6 16.4 8.7 15.3M12 5v14"/></svg></span><div><div class="pedido-summary-label">Total</div><div id="metDetalleTotal" class="pedido-summary-value">-</div><div id="metDetalleMoneda" class="pedido-summary-caption">USD</div></div></div>
    <div class="pedido-summary-card"><span class="pedido-summary-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v5H4zM6 9v11h12V9M9 13h6"/></svg></span><div><div class="pedido-summary-label">Exportaciones</div><div id="metDetalleExportaciones" class="pedido-summary-value">-</div><div id="metDetalleExportacionEstado" class="pedido-summary-caption">Sin exportaciones</div></div></div>
  </section>

  <section class="pedido-section-card">
    <div class="pedido-section-head"><div><div class="pedido-section-kicker">CABECERA</div><div class="pedido-section-title">Información del Pedido</div></div></div>
    <div class="pedido-meta-grid">
      <div class="pedido-meta-item"><span class="pedido-meta-label">Alta</span><strong id="infoCodigoAlta" class="pedido-meta-value">-</strong></div>
      <div class="pedido-meta-item"><span class="pedido-meta-label">Proveedor</span><strong id="infoProveedor" class="pedido-meta-value">-</strong></div>
      <div class="pedido-meta-item"><span class="pedido-meta-label">Orden</span><strong id="infoOrden" class="pedido-meta-value">-</strong></div>
      <div class="pedido-meta-item"><span class="pedido-meta-label">Moneda</span><strong id="infoMoneda" class="pedido-meta-value">-</strong></div>
      <div class="pedido-meta-item pedido-status-badge"><span class="pedido-meta-label">Estado</span><strong id="infoEstado" class="pedido-meta-value">-</strong></div>
      <div class="pedido-meta-item"><span class="pedido-meta-label">Fecha</span><strong id="infoFecha" class="pedido-meta-value">-</strong></div>
    </div>
    <div id="infoObservaciones" class="pedido-observations"></div>
  </section>

  <section id="panelHistorialExportaciones" class="pedido-section-card pedido-export-card d-none">
    <div class="pedido-section-head">
      <div><div class="pedido-section-kicker">EXPORTACIONES</div><div class="pedido-section-title">Historial de archivos generados</div></div>
      <div class="pedido-export-head-actions">
        <div id="resumenExportacionesPedido" class="pedido-section-summary"></div>
        <button id="btnToggleHistorialExportaciones" class="btn btn-sm btn-outline-secondary pedido-history-toggle" type="button" aria-expanded="false" aria-controls="contenidoHistorialExportaciones">
          <span id="textoToggleHistorialExportaciones">Ver historial</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
      </div>
    </div>
    <div id="contenidoHistorialExportaciones" class="d-none">
      <div class="table-responsive"><table class="table align-middle mb-0 pedidos-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Archivo</th><th>Registros</th><th>Usuario</th><th>Estado</th></tr></thead><tbody id="tablaExportacionesPedido"></tbody></table></div>
    </div>
  </section>

  <section id="panelProductosDisponibles" class="pedido-section-card d-none">
    <div class="pedido-section-head">
      <div><div class="pedido-section-kicker">PASO 2 · CARGA MANUAL</div><div class="pedido-section-title">Productos disponibles del Alta + Proveedor</div></div>
      <div id="resumenProductosDisponibles" class="pedido-section-summary"></div>
    </div>
    <div class="pedido-products-workspace">
      <div class="pedido-products-toolbar">
        <div class="pedido-products-count">Elegí un producto y cargá cantidad, FOB y adicional.</div>
        <input id="buscarProductoPedido" class="form-control pedido-search-line" type="search" placeholder="Buscar modelo, color, detalle, talle o curva...">
      </div>
      <div id="tablaProductosDisponibles" class="pedido-available-grid"></div>
    </div>
  </section>

  <section class="pedido-section-card pedido-product-card">
    <div class="pedido-section-head">
      <div><div class="pedido-section-kicker">DETALLE</div><div class="pedido-section-title">Productos del Pedido</div></div>
      <div id="resumenPedido" class="pedido-section-summary"></div>
    </div>
    <div class="pedido-loaded-workspace">
      <div id="tablaDetallePedido" class="pedido-loaded-grid"></div>
    </div>
  </section>

  <div class="modal fade" id="modalProductoPedido" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="modalProductoTitulo" class="modal-title">Cargar producto</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="formProductoPedido"><div class="modal-body"><input id="modalIdProducto" type="hidden"><input id="modalIdDetalle" type="hidden"><div id="modalProductoInfo" class="pedido-producto-resumen mb-3"></div><div class="row g-3 pedido-modal-fields"><div class="col-12 col-md-4"><label class="form-label" for="modalCantidadPares">Cantidad pares</label><input id="modalCantidadPares" class="form-control" type="number" min="1" step="1" required></div><div class="col-12 col-md-4"><label class="form-label" for="modalFobPar">FOB por par</label><input id="modalFobPar" class="form-control" type="number" min="0.0001" step="0.0001" required></div><div class="col-12 col-md-4"><label class="form-label" for="modalAdicional">Adicional por par</label><input id="modalAdicional" class="form-control" type="number" min="0" step="0.0001" value="0" required></div><div class="col-12"><label class="form-label" for="modalObservaciones">Observaciones</label><textarea id="modalObservaciones" class="form-control" rows="2" maxlength="500"></textarea></div></div><div id="modalCalculo" class="pedido-calculo mt-3"></div></div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button><button id="btnGuardarProducto" type="submit" class="btn btn-primary">Guardar producto</button></div></form></div></div></div>


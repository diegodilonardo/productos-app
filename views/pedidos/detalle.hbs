<div class="pedidos-v1" id="pedidoDetalleApp" data-id-pedido="{{idPedido}}">
  <section class="pedidos-hero">
    <div class="pedidos-hero-main">
      <span class="pedidos-hero-icon pedido-detail-hero-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 7h14v12H5z"></path><path d="M8 7V5h8v2M8 11h8M8 15h5"></path></svg>
      </span>
      <div>
        <div class="pedidos-kicker">DETALLE DEL PEDIDO</div>
        <h1 id="tituloPedido" class="h3 mb-1">Cargando...</h1>
        <div id="subtituloPedido" class="text-secondary"></div>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="/pedidos">Volver</a>
      <button id="btnAnularPedido" class="btn btn-outline-danger d-none" type="button">Anular</button>
      <button id="btnValidarPedido" class="btn btn-success d-none" type="button">Validar Pedido</button>
    </div>
  </section>

  <div id="alertaDetallePedido" class="alert d-none" role="alert"></div>

  <div class="card pedidos-card pedido-detail-summary mb-3">
    <div class="card-body p-3">
      <div class="pedido-info-grid">
        <div><span>Alta</span><strong id="infoCodigoAlta">-</strong></div>
        <div><span>Proveedor</span><strong id="infoProveedor">-</strong></div>
        <div><span>Orden</span><strong id="infoOrden">-</strong></div>
        <div><span>Moneda</span><strong id="infoMoneda">-</strong></div>
        <div><span>Estado</span><strong id="infoEstado">-</strong></div>
        <div><span>Fecha</span><strong id="infoFecha">-</strong></div>
      </div>
      <div id="infoObservaciones" class="small text-secondary mt-3"></div>
    </div>
  </div>

  <div id="accionesExportacionPedido" class="card pedidos-card pedido-export-card mb-3 d-none">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <div class="pedidos-kicker">EXPORTACIÓN</div>
          <strong>Archivos del Pedido</strong>
          <div class="small text-secondary mt-1">Disponibles cuando el Pedido se encuentra VALIDADO.</div>
          <div id="destinoExportacionPedido" class="small mt-2"></div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a id="btnExportarPedidoExcel" class="btn btn-outline-primary" href="#">Exportar Pedido Excel</a>
          <a id="btnExportarMasterData" class="btn btn-primary" href="#">Exportar Master Data</a>
          <a id="btnExportarPrecFob" class="btn btn-outline-primary" href="#">Exportar PREC_FOB</a>
        </div>
      </div>
    </div>
  </div>

  <div id="panelProductosDisponibles" class="card pedidos-card mb-3 d-none">
    <div class="pedidos-list-head">
      <div><div class="pedidos-kicker">ALTA + PROVEEDOR</div><strong>Productos disponibles</strong></div>
      <div class="pedido-detail-toolbar">
        <input id="buscarProductoPedido" class="form-control pedido-busqueda-producto" type="search" placeholder="Buscar modelo, color, detalle o curva...">
        <div class="pedidos-view-switch" aria-label="Vista de productos disponibles">
          <button id="btnDisponiblesTarjetas" class="pedidos-view-btn is-active" type="button" aria-pressed="true">▦ Tarjetas</button>
          <button id="btnDisponiblesLista" class="pedidos-view-btn" type="button" aria-pressed="false">☷ Lista</button>
        </div>
      </div>
    </div>
    <div id="tarjetasProductosDisponibles" class="pedido-product-card-grid"></div>
    <div id="listaProductosDisponibles" class="table-responsive d-none">
      <table class="table align-middle mb-0 pedidos-table pedido-productos-table">
        <thead><tr><th>Imagen</th><th>Modelo</th><th>Color</th><th>Detalle producto</th><th>Talle / Curva</th><th>Pares</th><th>Edad</th><th>Sexo</th><th>Tipo módulo</th><th></th></tr></thead>
        <tbody id="tablaProductosDisponibles"></tbody>
      </table>
    </div>
  </div>

  <div class="card pedidos-card overflow-hidden">
    <div class="pedidos-list-head">
      <div><div class="pedidos-kicker">DETALLE</div><strong>Productos del Pedido</strong></div>
      <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
        <div id="resumenPedido" class="pedido-resumen"></div>
        <div class="pedidos-view-switch" aria-label="Vista del detalle del pedido">
          <button id="btnDetalleTarjetas" class="pedidos-view-btn is-active" type="button" aria-pressed="true">▦ Tarjetas</button>
          <button id="btnDetalleLista" class="pedidos-view-btn" type="button" aria-pressed="false">☷ Lista</button>
        </div>
      </div>
    </div>
    <div id="tarjetasDetallePedido" class="pedido-product-card-grid pedido-detail-card-grid"></div>
    <div id="listaDetallePedido" class="table-responsive d-none">
      <table class="table align-middle mb-0 pedidos-table">
        <thead><tr><th>Imagen</th><th>Producto</th><th>Curva</th><th>Pares</th><th>Módulos</th><th>FOB/Par</th><th>FOB</th><th>Adicional/Par</th><th>Total</th><th></th></tr></thead>
        <tbody id="tablaDetallePedido"></tbody>
      </table>
    </div>
  </div>

  <div id="panelHistorialExportaciones" class="card pedidos-card mt-3 d-none">
    <div class="pedidos-list-head">
      <div>
        <div class="pedidos-kicker">EXPORTACIONES</div>
        <strong>Historial del Pedido</strong>
      </div>
      <div id="resumenExportacionesPedido" class="pedido-resumen">0 exportaciones</div>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0 pedidos-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Archivo</th>
            <th>Registros</th>
            <th>Usuario</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody id="tablaExportacionesPedido"></tbody>
      </table>
    </div>
  </div>

  <div class="modal fade" id="modalProductoPedido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h5 id="modalProductoTitulo" class="modal-title">Cargar producto</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="formProductoPedido"><div class="modal-body">
        <input id="modalIdProducto" type="hidden"><input id="modalIdDetalle" type="hidden">
        <div id="modalProductoInfo" class="pedido-producto-resumen mb-3"></div>
        <div class="row g-3">
          <div class="col-12 col-md-4"><label class="form-label" for="modalCantidadPares">Cantidad pares</label><input id="modalCantidadPares" class="form-control" type="number" min="1" step="1" required></div>
          <div class="col-12 col-md-4"><label class="form-label" for="modalFobPar">FOB por par</label><input id="modalFobPar" class="form-control" type="number" min="0" step="0.0001" required></div>
          <div class="col-12 col-md-4"><label class="form-label" for="modalAdicional">Adicional por par</label><input id="modalAdicional" class="form-control" type="number" min="0" step="0.0001" value="0" required></div>
          <div class="col-12"><label class="form-label" for="modalObservaciones">Observaciones</label><textarea id="modalObservaciones" class="form-control" rows="2" maxlength="500"></textarea></div>
        </div>
        <div id="modalCalculo" class="pedido-calculo mt-3"></div>
      </div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button><button id="btnGuardarProducto" type="submit" class="btn btn-primary">Guardar producto</button></div></form>
    </div></div>
  </div>

  <div class="modal fade" id="modalAnularPedido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Anular Pedido</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="formAnularPedido"><div class="modal-body"><label class="form-label" for="motivoAnulacion">Motivo de anulación</label><textarea id="motivoAnulacion" class="form-control" rows="4" maxlength="500" required></textarea><div class="form-text">El motivo es obligatorio.</div></div><div class="modal-footer"><button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button><button id="btnConfirmarAnulacion" class="btn btn-danger" type="submit">Anular Pedido</button></div></form>
    </div></div>
  </div>
</div>

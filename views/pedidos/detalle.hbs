kspace{padding:14px 16px 16px}.pedido-loaded-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pedido-loaded-card{border:1px solid #e1e7ef;border-radius:14px;background:#fff;overflow:hidden;min-width:0;box-shadow:0 .12rem .45rem rgba(33,50,75,.035)}.pedido-loaded-card:hover{border-color:#c9d9ef}.pedido-loaded-head{display:flex;align-items:flex-start;gap:11px;padding:12px 13px 10px}.pedido-loaded-img{width:54px;height:54px;object-fit:contain;flex:0 0 auto;border:1px solid #e5eaf0;border-radius:11px;background:#f7f9fc}.pedido-loaded-placeholder{width:54px;height:54px;flex:0 0 auto;display:grid;place-items:center;border:1px dashed #d9e1ea;border-radius:11px;background:#f8fafc;color:#9aa7b7}.pedido-loaded-placeholder svg{width:21px;height:21px}.pedido-loaded-titlewrap{min-width:0;flex:1}.pedido-loaded-title{font-size:.88rem;line-height:1.25;font-weight:760;color:#182230;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.pedido-loaded-code{font-size:.68rem;color:#8794a4;margin-top:3px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}.pedido-loaded-curve{font-size:.72rem;color:#64748b;background:#f5f8fc;border:1px solid #e6ebf2;border-radius:999px;padding:4px 8px;white-space:nowrap;max-width:42%;overflow:hidden;text-overflow:ellipsis}.pedido-loaded-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #edf1f5;border-bottom:1px solid #edf1f5}.pedido-loaded-metric{padding:9px 10px;min-width:0;border-right:1px solid #edf1f5}.pedido-loaded-metric:last-child{border-right:0}.pedido-loaded-metric span{display:block;font-size:.6rem;text-transform:uppercase;letter-spacing:.045em;color:#8a97a7;font-weight:780}.pedido-loaded-metric strong{display:block;margin-top:2px;font-size:.8rem;color:#26313f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pedido-loaded-financial{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fbfcfe}.pedido-loaded-financial>div{padding:9px 10px;border-right:1px solid #edf1f5}.pedido-loaded-financial>div:last-child{border-right:0}.pedido-loaded-financial span{display:block;font-size:.6rem;text-transform:uppercase;letter-spacing:.045em;color:#8a97a7;font-weight:780}.pedido-loaded-financial strong{display:block;margin-top:2px;font-size:.82rem;color:#26313f}.pedido-loaded-total{background:#f1f7ff}.pedido-loaded-total strong{font-size:1rem;color:#0b57d0;font-weight:800}.pedido-section-summary{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap}.pedido-summary-chip{display:inline-flex;align-items:baseline;gap:6px;padding:5px 9px;border:1px solid #e1e8f0;border-radius:999px;background:#f8fafc}.pedido-summary-chip small{font-size:.61rem;text-transform:uppercase;letter-spacing:.04em;color:#8592a3;font-weight:780}.pedido-summary-chip strong{font-size:.76rem;color:#253142}.pedido-summary-chip-total{background:#eef6ff;border-color:#d7e7fb}.pedido-summary-chip-total strong{color:#0b57d0}.pedido-loaded-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 10px}.pedido-loaded-note{font-size:.7rem;color:#7b8797;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pedido-loaded-actions{display:flex;gap:6px}.pedido-loaded-empty{grid-column:1/-1;padding:34px 18px;text-align:center;border:1px dashed #dce3eb;border-radius:14px;background:#fbfcfe;color:#7d8998}

<style>
  .pedidos-metric-control{appearance:none;cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,background-color .16s ease}.pedidos-metric-control:hover{transform:translateY(-1px)}
  .pedidos-metric-card{transition:border-color .16s ease,box-shadow .16s ease,background-color .16s ease}.pedidos-metric-card.is-active{border-color:rgba(13,110,253,.55);box-shadow:0 0 0 3px rgba(13,110,253,.10),0 .35rem 1rem rgba(20,38,63,.08);background:rgba(13,110,253,.025)}
  .pedidos-metric-content{display:flex;align-items:center;gap:14px}.pedidos-metric-icon{width:46px;height:46px;flex:0 0 46px;display:inline-flex;align-items:center;justify-content:center;border-radius:14px;background:rgba(13,110,253,.08);color:#0d6efd}.pedidos-metric-icon svg{width:23px;height:23px}.pedidos-metric-icon.is-draft{background:rgba(108,117,125,.10);color:#6c757d}.pedidos-metric-icon.is-valid{background:rgba(25,135,84,.10);color:#198754}.pedidos-metric-icon.is-cancelled{background:rgba(220,53,69,.10);color:#dc3545}
  .pedidos-filter-card{margin-bottom:18px}.pedidos-filter-label{display:block;margin:0 0 5px 2px;font-size:.72rem;font-weight:700;letter-spacing:.035em;color:#728097;text-transform:uppercase}.pedidos-list-summary{font-size:.83rem;color:#8a96a8}
  .pedidos-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.pedido-list-card{border:1px solid #e1e7ef;border-radius:15px;background:#fff;box-shadow:0 .2rem .75rem rgba(29,45,70,.045);overflow:hidden;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.pedido-list-card:hover{transform:translateY(-2px);box-shadow:0 .55rem 1.35rem rgba(29,45,70,.09);border-color:#ccd7e5}.pedido-list-card.is-cancelled{opacity:.78}
  .pedido-list-card-head{padding:15px 16px 12px;border-bottom:1px solid #edf1f5}.pedido-list-card-title-row{display:flex;gap:10px;align-items:flex-start}.pedido-card-icon{width:38px;height:38px;border-radius:11px;background:#edf5ff;color:#0d6efd;display:flex;align-items:center;justify-content:center;flex:0 0 38px}.pedido-card-icon svg{width:20px;height:20px}.pedido-card-main{min-width:0;flex:1}.pedido-card-code{font-size:.79rem;font-weight:800;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pedido-card-subtitle{font-size:.79rem;color:#66758b;margin-top:4px}.pedido-card-badges{display:flex;flex-wrap:wrap;gap:7px;justify-content:flex-end;margin-top:12px}.pedido-card-badges .badge{font-size:.68rem}
  .pedido-card-info{padding:12px 16px;display:grid;grid-template-columns:1.45fr 1fr .85fr .55fr;gap:0;border-bottom:1px solid #edf1f5}.pedido-card-info>div{padding-right:10px;margin-right:10px;border-right:1px solid #e7ecf2;min-width:0}.pedido-card-info>div:last-child{border-right:0;margin-right:0;padding-right:0}.pedido-card-label{display:block;font-size:.68rem;color:#7b889b;margin-bottom:2px}.pedido-card-value{display:-webkit-box;font-size:.79rem;font-weight:650;line-height:1.25;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical;min-height:1.95em}.pedido-card-value.is-short{display:block;white-space:nowrap;text-overflow:ellipsis;min-height:0}
  .pedido-card-numbers{padding:12px 16px;display:grid;grid-template-columns:.8fr 1fr 1.4fr;gap:10px;border-bottom:1px solid #edf1f5}.pedido-number{display:flex;gap:8px;align-items:center}.pedido-number-icon{width:28px;height:28px;border-radius:8px;background:#f5f7fa;color:#66758b;display:flex;align-items:center;justify-content:center;flex:0 0 28px}.pedido-number-icon svg{width:16px;height:16px}.pedido-number strong{font-size:.9rem}.pedido-number span{font-size:.68rem;color:#7b889b;display:block}
  .pedido-card-foot{padding:11px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}.pedido-card-foot-meta{min-width:0}.pedido-card-foot-line{font-size:.75rem;color:#66758b}.pedido-card-reason{font-size:.72rem;color:#dc3545;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:280px}.pedido-card-empty{grid-column:1/-1;padding:48px 20px;text-align:center;color:#7b889b;background:#fff;border:1px dashed #ccd5df;border-radius:15px}
  @media(max-width:1399.98px){.pedidos-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:767.98px){.pedidos-card-grid{grid-template-columns:1fr}.pedido-card-info{grid-template-columns:1fr 1fr}.pedido-card-info>div{border-right:0;margin:0;padding:5px 8px 5px 0}.pedido-card-numbers{grid-template-columns:1fr 1fr}.pedido-card-numbers .pedido-number:last-child{grid-column:1/-1}.pedido-list-card-title-row{flex-wrap:wrap}}
</style>

<div class="pedidos-v1">
  <section class="pedidos-hero">
    <div><div class="pedidos-kicker">GESTIÓN COMERCIAL</div><h1 class="h3 mb-1">Pedidos</h1><p class="text-secondary mb-0">Pedidos generados a partir de Altas confirmadas en ERP.</p></div>
    <div class="d-flex gap-2"><button id="btnActualizarPedidos" class="btn btn-outline-secondary" type="button">Actualizar</button><a class="btn btn-primary" href="/pedidos/nuevo">Nuevo Pedido</a></div>
  </section>
  <div id="alertaPedidos" class="alert d-none" role="alert"></div>

  <div class="row g-3 pedidos-metrics">
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card h-100" data-metric-card=""><button type="button" class="card-body text-start border-0 bg-transparent w-100 h-100 pedidos-metric-control" data-filtro-estado=""><div class="pedidos-metric-content"><span class="pedidos-metric-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg></span><span><span class="pedidos-metric-label d-block">Total</span><span id="metTotal" class="pedidos-metric-value d-block">-</span></span></div></button></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card h-100" data-metric-card="BORRADOR"><button type="button" class="card-body text-start border-0 bg-transparent w-100 h-100 pedidos-metric-control" data-filtro-estado="BORRADOR"><div class="pedidos-metric-content"><span class="pedidos-metric-icon is-draft"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></span><span><span class="pedidos-metric-label d-block">Borradores</span><span id="metBorrador" class="pedidos-metric-value d-block">-</span></span></div></button></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card h-100" data-metric-card="VALIDADO"><button type="button" class="card-body text-start border-0 bg-transparent w-100 h-100 pedidos-metric-control" data-filtro-estado="VALIDADO"><div class="pedidos-metric-content"><span class="pedidos-metric-icon is-valid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg></span><span><span class="pedidos-metric-label d-block">Validados</span><span id="metValidado" class="pedidos-metric-value d-block">-</span></span></div></button></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card h-100" data-metric-card="ANULADO"><button type="button" class="card-body text-start border-0 bg-transparent w-100 h-100 pedidos-metric-control" data-filtro-estado="ANULADO"><div class="pedidos-metric-content"><span class="pedidos-metric-icon is-cancelled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg></span><span><span class="pedidos-metric-label d-block">Anulados</span><span id="metAnulado" class="pedidos-metric-value d-block">-</span></span></div></button></div></div>
  </div>

  <div class="card pedidos-card pedidos-filter-card">
    <div class="card-body p-3">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-xl-4"><label class="pedidos-filter-label" for="buscarPedido">Buscar</label><input id="buscarPedido" class="form-control" type="search" placeholder="Pedido, Alta, proveedor u orden..."></div>
        <div class="col-6 col-md-3 col-xl-2"><label class="pedidos-filter-label" for="filtroEstadoPedido">Estado</label><select id="filtroEstadoPedido" class="form-select"><option value="">Todos los estados</option><option value="BORRADOR">Borrador</option><option value="VALIDADO">Validado</option><option value="ANULADO">Anulado</option></select></div>
        <div class="col-6 col-md-3 col-xl-2"><label class="pedidos-filter-label" for="filtroExportacionPedido">Exportación</label><select id="filtroExportacionPedido" class="form-select"><option value="">Todas</option><option value="NO_EXPORTADO">No exportado</option><option value="PARCIAL">Parcial</option><option value="COMPLETO">Completo</option></select></div>
        <div class="col-8 col-md-4 col-xl-3"><label class="pedidos-filter-label" for="ordenPedidos">Ordenar por</label><select id="ordenPedidos" class="form-select"><option value="FECHA_DESC">Más recientes</option><option value="FECHA_ASC">Más antiguos</option><option value="ORDEN_ASC">Orden A-Z</option><option value="PROVEEDOR_ASC">Proveedor A-Z</option><option value="PARES_DESC">Mayor cantidad de pares</option><option value="TOTAL_DESC">Mayor total</option></select></div>
        <div class="col-4 col-md-2 col-xl-1"><button id="btnLimpiarFiltrosPedidos" class="btn btn-outline-secondary w-100" type="button">Limpiar</button></div>
      </div>
    </div>
  </div>

  <div class="d-flex align-items-center justify-content-between mb-2 px-1"><div><div class="pedidos-kicker">PEDIDOS REGISTRADOS</div><div id="resumenListadoPedidos" class="pedidos-list-summary"></div></div></div>
  <div id="tarjetasPedidos" class="pedidos-card-grid"><div class="pedido-card-empty">Cargando pedidos...</div></div>
</div>

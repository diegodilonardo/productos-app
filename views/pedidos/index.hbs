<div class="pedidos-v1">
  <section class="pedidos-hero">
    <div class="pedidos-hero-main">
      <span class="pedidos-hero-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 7h14v12H5z"></path><path d="M8 7V5h8v2M8 11h8M8 15h5"></path></svg>
      </span>
      <div>
        <div class="pedidos-kicker">GESTIÓN COMERCIAL</div>
        <h1 class="h3 mb-1">Pedidos</h1>
        <p class="text-secondary mb-0">Pedidos generados a partir de Altas confirmadas en ERP.</p>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <select id="selectorEmpresaPedido" class="form-select d-none" style="width:auto;min-width:180px" aria-label="Empresa"></select>
      <span id="rolPedido" class="badge text-bg-light border d-none"></span>
      <button id="btnActualizarPedidos" class="btn btn-outline-secondary" type="button">Actualizar</button>
      <a id="btnNuevoPedido" class="btn btn-primary" href="/pedidos/nuevo">Nuevo Pedido</a>
    </div>
  </section>

  <div id="alertaPedidos" class="alert d-none" role="alert"></div>

  <div class="row g-3 pedidos-metrics">
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card"><div class="card-body"><span class="pedidos-metric-icon pedidos-tone-blue">Σ</span><div><div class="pedidos-metric-label">Total</div><div id="metTotal" class="pedidos-metric-value">-</div><div class="pedidos-metric-help">Pedidos registrados</div></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card"><div class="card-body"><span class="pedidos-metric-icon pedidos-tone-gray">✎</span><div><div class="pedidos-metric-label">Borradores</div><div id="metBorrador" class="pedidos-metric-value">-</div><div class="pedidos-metric-help">En preparación</div></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card"><div class="card-body"><span class="pedidos-metric-icon pedidos-tone-green">✓</span><div><div class="pedidos-metric-label">Validados</div><div id="metValidado" class="pedidos-metric-value">-</div><div class="pedidos-metric-help">Listos para exportar</div></div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card pedidos-card pedidos-metric-card"><div class="card-body"><span class="pedidos-metric-icon pedidos-tone-red">×</span><div><div class="pedidos-metric-label">Anulados</div><div id="metAnulado" class="pedidos-metric-value">-</div><div class="pedidos-metric-help">Fuera del circuito</div></div></div></div></div>
  </div>

  <div class="card pedidos-card overflow-hidden">
    <div class="pedidos-list-head">
      <div>
        <div class="pedidos-kicker">LISTADO</div>
        <strong>Pedidos registrados</strong>
        <span id="cantidadPedidosVisible" class="pedidos-result-count"></span>
      </div>
      <div class="pedidos-toolbar">
        <input id="buscarPedido" class="form-control" type="search" placeholder="Buscar pedido, Alta, proveedor u orden...">
        <select id="filtroEstadoPedido" class="form-select">
          <option value="">Todos los estados</option>
          <option value="BORRADOR">Borrador</option>
          <option value="VALIDADO">Validado</option>
          <option value="SINCRONIZADO">Sincronizado</option>
          <option value="ANULADO" disabled>Anulado</option>
        </select>
        <select id="filtroExportacionPedido" class="form-select">
          <option value="">Todas las exportaciones</option>
          <option value="NO_EXPORTADO">No exportado</option>
          <option value="PARCIAL">Parcial</option>
          <option value="COMPLETO">Completo</option>
        </select>
        <div class="form-check form-switch pedidos-cancel-switch">
          <input
            id="mostrarAnuladosPedido"
            class="form-check-input"
            type="checkbox"
            role="switch"
          >
          <label class="form-check-label" for="mostrarAnuladosPedido">
            Mostrar anulados
          </label>
        </div>
        <div class="pedidos-view-switch" role="group" aria-label="Vista del listado">
          <button id="btnVistaTarjetasPedidos" class="pedidos-view-btn" type="button" aria-pressed="true">▦ Tarjetas</button>
          <button id="btnVistaTablaPedidos" class="pedidos-view-btn" type="button" aria-pressed="false">☷ Tabla</button>
        </div>
      </div>
    </div>
    <div id="tarjetasPedidos" class="pedidos-card-grid" aria-live="polite"><div class="pedidos-cards-loading">Cargando...</div></div>
    <div id="vistaTablaPedidos" class="table-responsive d-none">
      <table class="table table-hover align-middle mb-0 pedidos-table">
        <thead><tr><th>Pedido</th><th>Alta</th><th>Proveedor</th><th>Orden</th><th>Productos</th><th>Pares</th><th>Total</th><th>Estado</th><th>Exportación</th><th>Fecha</th><th></th></tr></thead>
        <tbody id="tablaPedidos"><tr><td colspan="11" class="text-center py-5 text-secondary">Cargando...</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

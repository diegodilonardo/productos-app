<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; color: #000; background: #fff; font-family: Arial, Helvetica, sans-serif; }
    .print-toolbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 18px; color: #fff; background: #111827; }
    .print-toolbar button { border: 0; border-radius: 7px; padding: 9px 18px; color: #fff; background: #0d6efd; font-weight: 700; cursor: pointer; }
    .sheet { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 8mm; }
    .module-grid { display: grid; grid-template-columns: 1fr; gap: 4mm; }
    .module-label { height: 88mm; border: 1.4px solid #000; padding: 3mm; display: grid; grid-template-columns: 48mm 1fr; grid-template-rows: 19mm 1fr 24mm; gap: 2mm 3mm; break-inside: avoid; page-break-inside: avoid; overflow: hidden; }
    .module-photo { grid-row: 1 / 3; border: 1px solid #000; }
    .module-barcodes { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm; min-width: 0; }
    .barcode { min-width: 0; overflow: hidden; text-align: center; display: grid; grid-template-rows: minmax(0, 1fr) 5mm; }
    .barcode-bars { min-width: 0; min-height: 0; padding: 0 2mm; }
    .barcode-bars svg { display: block; width: 100%; height: 100%; }
    .barcode-value { display: flex; align-items: center; justify-content: center; font-family: Arial, Helvetica, sans-serif; font-size: 9.5pt; line-height: 1; letter-spacing: .5px; white-space: nowrap; }
    .module-data { min-width: 0; }
    .brand { margin: 0 0 2.5mm; font-size: 36pt; line-height: 1; text-align: center; font-weight: 400; letter-spacing: 1.2px; }
    .field { display: grid; grid-template-columns: 30mm 1fr; gap: 2mm; margin: 1.1mm 0; font-size: 12.5pt; line-height: 1.14; }
    .field b { text-decoration: underline; }
    .composition { grid-column: 1 / 3; display: grid; grid-template-columns: 1fr 31mm; gap: 2mm; border-top: 1.5px solid #000; padding-top: 2mm; }
    .sizes { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(10mm, 1fr); align-content: stretch; min-width: 0; }
    .size { display: grid; grid-template-rows: 1fr 1fr; border: 1px solid #000; border-right: 0; text-align: center; font-weight: 700; font-size: 13pt; }
    .size:last-child { border-right: 1px solid #000; }
    .size span { display: flex; align-items: center; justify-content: center; padding: 1mm; }
    .size span + span { border-top: 1px solid #000; }
    .total { border: 1px solid #000; display: grid; grid-template-rows: 1fr 1.35fr; text-align: center; font-weight: 700; }
    .total span { display: flex; align-items: center; justify-content: center; font-size: 13pt; }
    .total strong { display: flex; align-items: center; justify-content: center; border-top: 1px solid #000; font-size: 24pt; }
    .pair-section { break-before: page; page-break-before: always; }
    .pair-section.only { break-before: auto; page-break-before: auto; }
    .pair-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3mm; }
    .pair-label { height: 43mm; border: 0; border-bottom: .6px solid #777; padding: 2.5mm; display: grid; grid-template-columns: 1fr 22mm; grid-template-rows: 7mm 15mm 12mm; gap: 1mm 2mm; break-inside: avoid; page-break-inside: avoid; overflow: hidden; }
    .pair-label:nth-child(odd) { border-right: .6px solid #aaa; }
    .pair-title { grid-column: 1 / 3; font-size: 9pt; line-height: 1.05; text-align: center; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pair-ean { grid-column: 1; }
    .pair-size { grid-column: 2; grid-row: 2 / 4; display: flex; align-items: center; justify-content: center; font-size: 27pt; font-weight: 800; white-space: nowrap; }
    .pair-alpha { grid-column: 1; }
    .pair-label .barcode { grid-template-rows: minmax(0, 1fr) 4mm; }
    .pair-label .barcode-bars { padding: 0 2.5mm; }
    .pair-label .barcode-value { font-size: 8pt; }
    @page { size: A4 portrait; margin: 0; }
    @media print {
      .print-toolbar { display: none !important; }
      .sheet { margin: 0; }
      body[data-print="modulos"] .pair-section { display: none !important; }
      body[data-print="pares"] .module-grid { display: none !important; }
      body[data-print="pares"] .pair-section { break-before: auto; page-break-before: auto; }
    }
  </style>
</head>
<body>
  <div class="print-toolbar">
    <span>{{cantidadModulos}} módulo(s) y {{cantidadPares}} par(es) preparados</span>
    <span>
      {{#if hayModulos}}<button type="button" onclick="imprimir('modulos')">Imprimir módulos</button>{{/if}}
      {{#if hayPares}}<button type="button" onclick="imprimir('pares')">Imprimir pares individuales</button>{{/if}}
    </span>
  </div>

  {{#if hayModulos}}
  <section class="sheet module-grid" aria-label="Etiquetas de módulos">
    {{#each modulos}}
    <article class="module-label">
      <div class="module-photo" aria-hidden="true"></div>
      <div class="module-barcodes">
        <div class="barcode"><div class="barcode-bars">{{{barcodeAlfa}}}</div><div class="barcode-value">{{codigoAlfa}}</div></div>
        <div class="barcode"><div class="barcode-bars">{{{barcodeEan}}}</div><div class="barcode-value">{{ean}}</div></div>
      </div>
      <div class="module-data">
        <div class="brand">{{marca}}</div>
        <div class="field"><b>ARTÍCULO:</b><strong>{{articulo}}</strong></div>
        <div class="field"><b>TALLE:</b><strong>{{talleCurva}}</strong></div>
        <div class="field"><b>COLOR:</b><strong>{{color}}</strong></div>
      </div>
      <div class="composition">
        <div class="sizes">{{#each composicion}}<div class="size"><span>{{talle}}</span><span>{{pares}}</span></div>{{/each}}</div>
        <div class="total"><span>PARES</span><strong>{{totalPares}}</strong></div>
      </div>
    </article>
    {{/each}}
  </section>
  {{/if}}

  {{#if hayPares}}
  <section class="sheet pair-grid pair-section {{#unless hayModulos}}only{{/unless}}" aria-label="Etiquetas de pares individuales">
    {{#each pares}}
    <article class="pair-label">
      <div class="pair-title">{{articulo}} - {{color}}</div>
      <div class="barcode pair-ean"><div class="barcode-bars">{{{barcodeEan}}}</div><div class="barcode-value">{{ean}}</div></div>
      <div class="pair-size">T:{{talle}}</div>
      <div class="barcode pair-alpha"><div class="barcode-bars">{{{barcodeAlfa}}}</div><div class="barcode-value">{{codigoAlfa}}</div></div>
    </article>
    {{/each}}
  </section>
  {{/if}}
  <script>
    function imprimir(tipo) {
      const tituloAnterior = document.title;
      document.body.dataset.print = tipo;
      document.title = tipo === 'modulos' ? 'ETIQUETAS_MODULOS' : 'ETIQUETAS_PARES_INDIVIDUALES';
      window.print();
      window.setTimeout(function () {
        delete document.body.dataset.print;
        document.title = tituloAnterior;
      }, 500);
    }
  </script>
</body>
</html>

<div class="seguimiento-v2">
<section class="seguimiento-hero">
  <div class="seguimiento-hero-main">
    <span class="seguimiento-hero-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 19V5"></path><path d="M4 19h16"></path><path d="M7 15l4-4 3 2 5-6"></path><path d="M16.5 7H19v2.5"></path></svg>
    </span>
    <div>
      <div class="seguimiento-kicker">CIRCUITO ERP</div>
      <h1 class="h3 mb-1">Seguimiento ERP</h1>
      <p class="text-secondary mb-0">Estado de las altas exportadas y su confirmación en Presea.</p>
    </div>
  </div>

  <button id="btnActualizarSeguimiento" type="button" class="btn btn-outline-secondary seguimiento-refresh-btn">
    Actualizar
  </button>
</section>

<div id="alertaSeguimiento" class="alert d-none" role="alert"></div>

<div class="row g-3 seguimiento-metrics">
  <div class="col-6 col-xl-3">
    <div class="card shadow-sm h-100 seguimiento-metric-card">
      <div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-blue"><svg viewBox="0 0 24 24"><path d="M12 16V5"></path><path d="M8.5 8.5L12 5l3.5 3.5"></path><path d="M5 15.5v3h14v-3"></path></svg></span><div>
        <div class="app-info-label">Productos exportados</div><div id="resTotalExportados" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Enviados a Presea</div>
      </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="card shadow-sm h-100 seguimiento-metric-card">
      <div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-green"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 12.2l2.2 2.2 4.8-5"></path></svg></span><div>
        <div class="app-info-label">Confirmados ERP</div><div id="resConfirmados" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Generados correctamente</div>
      </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="card shadow-sm h-100 seguimiento-metric-card">
      <div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-amber"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v5l3 2"></path></svg></span><div>
        <div class="app-info-label">Pendientes ERP</div><div id="resPendientes" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Esperando confirmación</div>
      </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="card shadow-sm h-100 seguimiento-metric-card">
      <div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-red"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M9 9l6 6M15 9l-6 6"></path></svg></span><div>
        <div class="app-info-label">Errores ERP</div><div id="resErrores" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Requieren revisión</div>
      </div>
      </div>
    </div>
  </div>
</div>

<div class="seguimiento-legend"><span class="seguimiento-legend-title">Estados:</span><span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-pending"></i>Sin novedades</span><span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-partial"></i>Parcial</span><span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-ok"></i>Confirmado</span><span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-error"></i>Error</span></div>

<div class="card shadow-sm seguimiento-list-card">
  <div class="seguimiento-list-head">
      <div class="d-flex align-items-center gap-2">
        <span class="seguimiento-section-icon"><svg viewBox="0 0 24 24"><rect x="4" y="3.5" width="16" height="17" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h8"></path></svg></span>
        <div><div class="seguimiento-table-kicker">CONCILIACIÓN</div><h2 class="h5 mb-0">Altas exportadas <span id="cantidadSeguimientoVisible" class="seguimiento-result-count"></span></h2></div>
      </div>

      <div class="seguimiento-toolbar">
        <label class="seguimiento-filter-label" for="filtroEstadoSeguimiento">Estado</label>
        <select id="filtroEstadoSeguimiento" class="form-select">
          <option value="">Todos los estados</option>
          <option value="EXPORTADO">EXPORTADO</option>
          <option value="PARCIAL_ERP">PARCIAL_ERP</option>
          <option value="GENERADO_OK_EN_ERP">GENERADO_OK_EN_ERP</option>
          <option value="SIN_NOVEDADES_ERP">SIN_NOVEDADES_ERP</option>
          <option value="ANULADO" disabled>ANULADO</option>
        </select>
        <div class="form-check form-switch seguimiento-cancel-switch">
          <input id="mostrarAnuladasSeguimiento" class="form-check-input" type="checkbox" role="switch">
          <label class="form-check-label" for="mostrarAnuladasSeguimiento">Mostrar anuladas</label>
        </div>
        <div class="seguimiento-view-switch" role="group" aria-label="Vista del seguimiento">
          <button id="btnVistaTarjetasSeguimiento" class="seguimiento-view-option" type="button" aria-pressed="true">▦ Tarjetas</button>
          <button id="btnVistaTablaSeguimiento" class="seguimiento-view-option" type="button" aria-pressed="false">☷ Tabla</button>
        </div>
      </div>
  </div>

  <div id="tarjetasSeguimiento" class="seguimiento-card-grid" aria-live="polite"><div class="seguimiento-cards-loading">Cargando...</div></div>
  <div id="vistaTablaSeguimiento" class="table-responsive d-none">
    <table class="table table-hover align-middle mb-0 seguimiento-table">
      <thead>
        <tr>
          <th>Alta</th>
          <th>Marca</th>
          <th>Rubro</th>
          <th>Año / Temporada</th>
          <th>Licencia</th>
          <th>Tipo</th>
          <th>Estado</th>
          <th>ERP</th>
          <th style="min-width:180px">Avance</th>
          <th>Archivo</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="tablaSeguimientoAltas">
        <tr>
          <td colspan="11" class="text-center py-4 text-secondary">
            Cargando...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<section class="seguimiento-ean-section" aria-labelledby="tituloSeguimientoEan">
  <div class="seguimiento-ean-heading">
    <div>
      <div class="seguimiento-table-kicker">CÓDIGOS DE BARRAS</div>
      <h2 id="tituloSeguimientoEan" class="h4 mb-1">Seguimiento EAN / GS1</h2>
      <p class="text-secondary mb-0">Primeras y módulos confirmados en Presea, con el estado de asignación de su EAN definitivo.</p>
    </div>
    <div class="seguimiento-ean-actions">
      <div class="seguimiento-ean-action-group">
        <button id="btnDescargarImagenesEan" class="btn btn-primary" type="button" disabled>Descargar imágenes (0)</button>
        <input id="archivoUrlsTemporalesEan" class="d-none" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
        <button id="btnImportarUrlsTemporalesEan" class="btn btn-outline-primary" type="button" disabled>Importar URLs GS1</button>
      </div>
      <div class="seguimiento-ean-action-group">
        <button id="btnGenerarArchivoGs1" class="btn btn-success" type="button" disabled>Generar archivo GS1</button>
        <input id="archivoCodigosEanGs1" class="d-none" type="file" accept=".xlsx,.xls">
        <button id="btnImportarCodigosEanGs1" class="btn btn-outline-success" type="button" disabled>Importar EAN definitivos</button>
      </div>
      <div class="seguimiento-ean-action-group">
        <button id="btnExportarGtinDbi" class="btn btn-dark" type="button" disabled>Descargar GTIN.DBI</button>
        <button id="btnEnviarGtinPresea" class="btn btn-primary" type="button" disabled>Enviar GTIN a Presea</button>
      </div>
      <div class="seguimiento-ean-action-group">
        <button id="btnImprimirEtiquetasEan" class="btn btn-outline-dark" type="button" disabled>Imprimir etiquetas (0)</button>
      <a id="btnExportarPendientesEan" class="btn btn-outline-primary disabled" aria-disabled="true" tabindex="-1" href="/api/seguimiento/ean/pendientes.xlsx">Descargar pendientes GS1</a>
      </div>
    </div>
  </div>

  <div class="row g-3 seguimiento-metrics seguimiento-ean-metrics">
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-blue">#</span><div><div class="app-info-label">Productos evaluados</div><div id="eanTotal" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Total del circuito</div></div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-amber">!</span><div><div class="app-info-label">Gestionar en GS1</div><div id="eanPendientesGs1" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Con código provisorio</div></div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-blue">✓</span><div><div class="app-info-label">EAN asignados</div><div id="eanAsignados" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Pendientes de enviar</div></div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-amber">⇧</span><div><div class="app-info-label">Pendientes ERP</div><div id="eanPendientesErp" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">GTIN.DBI enviado</div></div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-green">✓</span><div><div class="app-info-label">Confirmados ERP</div><div id="eanConfirmadosErp" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">EAN conciliado</div></div></div></div></div>
    <div class="col-6 col-xl-2"><div class="card shadow-sm h-100 seguimiento-metric-card"><div class="card-body"><span class="seguimiento-metric-icon seguimiento-tone-red">×</span><div><div class="app-info-label">Sin EAN</div><div id="eanSinEan" class="seguimiento-metric-value">-</div><div class="seguimiento-metric-help">Requieren revisión</div></div></div></div></div>
  </div>

  <div id="eanAvisoGs1" class="alert alert-warning d-none seguimiento-ean-alert" role="status"></div>
  <div id="resultadoUrlsTemporalesEan" class="alert alert-info d-none seguimiento-ean-alert" role="status"></div>

  <div id="listadoProductosEan" class="card shadow-sm seguimiento-list-card seguimiento-ean-product-list">
    <div class="seguimiento-list-head">
      <div><div class="seguimiento-table-kicker">GESTIÓN GS1</div><h3 class="h5 mb-0">Productos <span id="cantidadEanVisible" class="seguimiento-result-count"></span></h3></div>
      <div class="seguimiento-ean-filters">
        <input id="buscarSeguimientoEan" class="form-control" type="search" placeholder="Buscar Alta, código, modelo o color..." aria-label="Buscar productos por EAN">
        <select id="filtroEstadoEan" class="form-select" aria-label="Filtrar por estado EAN">
          <option value="">Todos los estados</option>
          <option value="PENDIENTE_GS1">Gestionar en GS1</option>
          <option value="EAN_ASIGNADO">EAN asignado</option>
          <option value="PENDIENTE_ERP">Enviado · pendiente ERP</option>
          <option value="CONFIRMADO_ERP">Confirmado en ERP</option>
          <option value="SIN_EAN">Sin EAN</option>
        </select>
        <select id="filtroTemporadaEan" class="form-select" aria-label="Filtrar por temporada"><option value="">Todas las temporadas</option></select>
        <select id="filtroAnoEan" class="form-select" aria-label="Filtrar por año"><option value="">Todos los años</option></select>
        <select id="filtroRubroEan" class="form-select" aria-label="Filtrar por rubro"><option value="">Todos los rubros</option></select>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 seguimiento-table seguimiento-ean-table">
        <thead><tr><th><input id="seleccionarTodosEan" class="form-check-input me-2" type="checkbox" aria-label="Seleccionar todos los productos filtrados de todas las páginas">Imagen</th><th>Producto</th><th>Modelo / Color</th><th>Talle / Curva</th><th>EAN actual</th><th>Estado</th><th>Alta</th></tr></thead>
        <tbody id="tablaSeguimientoEan"><tr><td colspan="7" class="text-center py-4 text-secondary">Cargando...</td></tr></tbody>
      </table>
    </div>
    <div id="paginacionSeguimientoEan" class="seguimiento-ean-pagination d-none" aria-label="Paginación de productos EAN"></div>
  </div>
</section>

</div>

<script src="/js/seguimiento.js?v=16"></script>

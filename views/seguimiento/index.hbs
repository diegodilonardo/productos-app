<div class="seguimiento-v2">

  <section class="seguimiento-hero">
    <div class="seguimiento-hero-main">
      <div class="seguimiento-hero-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M7 15l4-4 3 2 5-6"/><path d="M16.5 7H19v2.5"/></svg>
      </div>

      <div>
        <div class="seguimiento-kicker">CONTROL ERP</div>
        <h1 class="h3 mb-1">Seguimiento ERP</h1>
        <p class="text-secondary mb-0">
          Estado de las altas exportadas y su confirmación en Presea.
        </p>
      </div>
    </div>

    <button id="btnActualizarSeguimiento" type="button" class="btn btn-outline-primary seguimiento-refresh-btn">
      Actualizar
    </button>
  </section>

  <div id="alertaSeguimiento" class="alert d-none" role="alert"></div>

  <section class="row g-3 seguimiento-metrics">
    <div class="col-6 col-xl-3">
      <div class="card seguimiento-metric-card h-100">
        <div class="card-body">
          <div class="seguimiento-metric-icon seguimiento-tone-blue">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5"/><path d="M8.5 8.5L12 5l3.5 3.5"/><path d="M5 15.5v3h14v-3"/></svg>
          </div>
          <div>
            <div class="app-info-label">Productos exportados</div>
            <div id="resTotalExportados" class="seguimiento-metric-value">-</div>
            <div class="seguimiento-metric-help">Enviados a Presea</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-xl-3">
      <div class="card seguimiento-metric-card h-100">
        <div class="card-body">
          <div class="seguimiento-metric-icon seguimiento-tone-green">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M8.5 12.2l2.2 2.2 4.8-5"/></svg>
          </div>
          <div>
            <div class="app-info-label">Confirmados ERP</div>
            <div id="resConfirmados" class="seguimiento-metric-value">-</div>
            <div class="seguimiento-metric-help">Generados correctamente</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-xl-3">
      <div class="card seguimiento-metric-card h-100">
        <div class="card-body">
          <div class="seguimiento-metric-icon seguimiento-tone-amber">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
          </div>
          <div>
            <div class="app-info-label">Pendientes ERP</div>
            <div id="resPendientes" class="seguimiento-metric-value">-</div>
            <div class="seguimiento-metric-help">Esperando confirmación</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-xl-3">
      <div class="card seguimiento-metric-card h-100">
        <div class="card-body">
          <div class="seguimiento-metric-icon seguimiento-tone-red">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/></svg>
          </div>
          <div>
            <div class="app-info-label">Errores ERP</div>
            <div id="resErrores" class="seguimiento-metric-value">-</div>
            <div class="seguimiento-metric-help">Requieren revisión</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="seguimiento-legend">
    <span class="seguimiento-legend-title">Estados:</span>
    <span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-pending"></i>Pendiente</span>
    <span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-partial"></i>Parcial</span>
    <span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-ok"></i>Confirmado</span>
    <span class="seguimiento-legend-item"><i class="seguimiento-dot seguimiento-dot-error"></i>Error</span>
  </div>

  <div class="card seguimiento-list-card">
    <div class="seguimiento-list-head">
      <div class="d-flex align-items-center gap-2">
        <span class="seguimiento-section-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 8h8M8 12h8M8 16h8"/></svg>
        </span>
        <div>
          <div class="seguimiento-table-kicker">LOTES EXPORTADOS</div>
          <h2 class="h5 mb-0">Altas</h2>
        </div>
      </div>

      <div class="seguimiento-toolbar">
        <label class="seguimiento-filter-label" for="filtroEstadoSeguimiento">Estado</label>
        <select id="filtroEstadoSeguimiento" class="form-select">
          <option value="">Todos los estados</option>
          <option value="EXPORTADO">EXPORTADO</option>
          <option value="PARCIAL_ERP">PARCIAL_ERP</option>
          <option value="GENERADO_OK_EN_ERP">GENERADO_OK_EN_ERP</option>
        </select>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 seguimiento-table">
        <thead>
          <tr>
            <th>Alta</th>
            <th>Marca</th>
            <th>Rubro</th>
            <th>Año / Temporada</th>
            <th>Licencia</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>ERP</th>
            <th style="min-width:200px">Avance</th>
            <th>Archivo</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="tablaSeguimientoAltas">
          <tr>
            <td colspan="11" class="text-center py-5 text-secondary">
              Cargando...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script src="/js/seguimiento.js"></script>

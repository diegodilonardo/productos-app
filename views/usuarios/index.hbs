<div class="account-v2 usuarios-v2">
<section class="account-hero">
  <div class="account-hero-main">
    <span class="account-hero-icon account-hero-icon-purple" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M4 19v-2.2c0-2.1 1.9-3.8 4.2-3.8h1.6c2.3 0 4.2 1.7 4.2 3.8V19"></path><path d="M16 8h4M18 6v4M16 14h4M16 18h4"></path></svg></span>
    <div><div class="account-kicker">SEGURIDAD Y ACCESOS</div><h1 class="h3 mb-1">Usuarios y permisos</h1><p class="text-secondary mb-0">Administración de usuarios y alcances por empresa.</p></div>
  </div>

  <div class="d-flex gap-2">
    <button id="btnNuevoUsuario" class="btn btn-primary" type="button">
      Nuevo usuario
    </button>
    <button id="btnActualizarUsuarios" class="btn btn-outline-secondary" type="button">
      Actualizar
    </button>
  </div>
</section>

<div id="alertaUsuarios" class="alert d-none" role="alert"></div>

<div class="row g-4">
  <div class="col-12 col-xl-5">
    <div class="card app-card h-100">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Usuarios</strong>
        <div class="d-flex align-items-center gap-2">
          <span id="cantidadUsuarios" class="badge text-bg-light">0</span>
          <div class="usuarios-view-switch" role="group" aria-label="Vista de usuarios">
            <button id="btnVistaTablaUsuarios" class="usuarios-view-btn" type="button" aria-pressed="true">☷ Tabla</button>
            <button id="btnVistaTarjetasUsuarios" class="usuarios-view-btn" type="button" aria-pressed="false">▦ Tarjetas</button>
          </div>
        </div>
      </div>

      <div class="card-body p-0">
        <div id="tarjetasUsuarios" class="usuarios-card-grid d-none" aria-live="polite"></div>
        <div id="vistaTablaUsuarios" class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Usuario</th>
                <th>Estado</th>
                <th>Accesos</th>
              </tr>
            </thead>
            <tbody id="tablaUsuarios">
              <tr>
                <td colspan="3" class="text-center py-5 text-secondary">Cargando...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-7">
    <div class="card app-card h-100">
      <div class="card-header bg-white">
        <strong>Ficha de seguridad</strong>
      </div>

      <div id="detalleUsuario" class="card-body">
        <div class="text-secondary text-center py-5">
          Seleccioná un usuario para consultar sus permisos.
        </div>
      </div>
    </div>
  </div>
</div>
</div>
